@@ -121,3 +122,38 @@ func ResolveRoute(metadata *C.Metadata) (C.Proxy, error) {
 	proxy, _, err := resolveMetadata(metadata)
 	return proxy, err
 }
+
+// DirectSplitHook lets the host send a connection an explicit DIRECT rule
+// matched through another proxy, by name; empty keeps it direct. ReClash uses
+// it where direct access to home sites is lost. It runs on every such match,
+// under the config lock, and must not block.
+var DirectSplitHook func(metadata *C.Metadata) string
+
+// SiteLockHook lets the host claim a connection before the mode, any rule or
+// a listener's own proxy is consulted: a non-nil proxy is used as is, and rule
+// names the claim. Only the inner listener's connections skip it. It runs
+// outside the config lock, may use helper's lazy lookups, and must not block
+// beyond them.
+var SiteLockHook func(metadata *C.Metadata, helper C.RuleMatchHelper) (C.Proxy, C.Rule)
+
+func specialProxy(metadata *C.Metadata) (C.Proxy, C.Rule, error) {
+	if proxy, ok := proxies[metadata.SpecialProxy]; ok {
+		return proxy, nil, nil
+	}
+	return nil, nil, fmt.Errorf("proxy %s not found", metadata.SpecialProxy)
+}
+
+var MetadataPolicyHook func(metadata *C.Metadata) error
+var ModeChangeHook func(mode TunnelMode)
+
+// The final MATCH rule is not split: "proxy everything" is never implied.
+func directSplit(metadata *C.Metadata, adapter C.Proxy, rule C.Rule) C.Proxy {
+	if DirectSplitHook == nil || adapter.Type() != C.Direct || rule.RuleType() == C.MATCH {
+		return nil
+	}
+	target, ok := proxies[DirectSplitHook(metadata)]
+	if !ok || metadata.NetWork == C.UDP && !target.SupportUDP() {
+		return nil
+	}
+	return target
+}
