+// chargeDownlink reserves n bytes of the carrier-wide downlink budget. A
+// zero budget disables the cap; the per-session queue still bounds each
+// session.
+func (w *carrierWorker) chargeDownlink(n int) bool {
+	limit := w.maxBuffered.Load()
+	if limit <= 0 {
+		return true
+	}
+	total := w.buffered.Add(int64(n))
