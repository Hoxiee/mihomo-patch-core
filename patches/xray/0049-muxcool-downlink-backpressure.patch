+
+// seal stops new pushes and wakes waiters. With drop, queued items are
+// returned for the caller to release; without it they stay for the consumer
+// to drain before errQueueClosed.
+func (q *byteQueue[T]) seal(drop bool) []T {
+	q.mu.Lock()
+	if q.closed {
+		q.mu.Unlock()
+		return nil
+	}
+	q.closed = true
+	var dropped []T
+	if drop {
+		dropped = q.items
+		q.items = nil
+		if q.credit != nil && q.bytes > 0 {
+			q.credit(q.bytes)
+		}
+		q.bytes = 0
+	}
+	signal := q.notify
+	q.notify = make(chan struct{})
+	q.mu.Unlock()
+	close(signal)
+	return dropped
+}
+
+func deadlineExpired(d *deadline.PipeDeadline) bool {
+	select {
+	case <-d.Wait():
+		return true
+	default:
+		return false
+	}
+}
+
+func (q *byteQueue[T]) stats() (items, bytes int) {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	return len(q.items), q.bytes
+}
