diff --git a/transport/muxcool/queue.go b/transport/muxcool/queue.go
new file mode 100644
index 0000000..717dbeb
--- /dev/null
+++ b/transport/muxcool/queue.go
@@ -0,0 +1,181 @@
+package muxcool
+
+import (
+	"errors"
+	"os"
+	"sync"
+
+	"github.com/metacubex/mihomo/common/net/deadline"
+)
+
+// errQueueClosed means the session ended and nothing is left to drain.
+var errQueueClosed = errors.New("mux.cool session queue is closed")
+
+// errQueueOverflow means the session's consumer fell too far behind. The
+// carrier read loop feeds every session on one physical connection, so it
+// must never wait on a single consumer: the caller turns an overflow into a
+// session reset instead of stalling the siblings.
+var errQueueOverflow = errors.New("mux.cool session queue is full")
+
+// byteQueue is a bounded FIFO between the carrier read loop and one session
+// consumer. Producers never block; the byte budget is the real limit and the
+// item count bounds per-item overhead. Ownership of an item passes to the
+// queue on a successful push and back to the consumer on pop or seal.
+type byteQueue[T any] struct {
+	mu       sync.Mutex
+	items    []T
+	bytes    int
+	closed   bool
+	notify   chan struct{}
+	maxBytes int
+	maxItems int
+	sizeOf   func(T) int
+	release  func(T)
+	charge   func(int) bool
+	credit   func(int)
+}
+
+func newByteQueue[T any](
+	sizeOf func(T) int,
+	release func(T),
+	maxBytes, maxItems int,
+) *byteQueue[T] {
+	return &byteQueue[T]{
+		notify:   make(chan struct{}),
+		maxBytes: maxBytes,
+		maxItems: maxItems,
+		sizeOf:   sizeOf,
+		release:  release,
+	}
+}
+
+// push appends item without waiting. It reports errQueueClosed when the
+// session ended, and errQueueOverflow when the item would exceed either
+// bound or the carrier-wide budget; in both cases item has been released.
+func (q *byteQueue[T]) push(item T) error {
+	size := q.sizeOf(item)
+	q.mu.Lock()
+	if q.closed {
+		q.mu.Unlock()
+		q.release(item)
+		return errQueueClosed
+	}
+	if q.maxItems > 0 && len(q.items) >= q.maxItems {
+		q.mu.Unlock()
+		q.release(item)
+		return errQueueOverflow
+	}
+	if q.maxBytes > 0 && q.bytes+size > q.maxBytes {
+		q.mu.Unlock()
+		q.release(item)
+		return errQueueOverflow
+	}
+	if q.charge != nil && size > 0 && !q.charge(size) {
+		q.mu.Unlock()
+		q.release(item)
+		return errQueueOverflow
+	}
+	q.items = append(q.items, item)
