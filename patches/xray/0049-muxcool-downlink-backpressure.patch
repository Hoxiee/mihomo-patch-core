+// A TCP consumer that stops reading must not stall the carrier read loop:
+// its own bounded queue overflows, that session resets, and the siblings
+// keep receiving frames.
+func TestSlowStreamConsumerDoesNotBlockSibling(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	t.Cleanup(func() { worker.close(nil) })
+
+	slow, err := worker.openSession(context.Background(), "slow.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = slow.Close() })
+	fast, err := worker.openSession(context.Background(), "fast.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = fast.Close() })
+
+	payload := bytes.Repeat([]byte{0x5a}, MaxPayloadSize)
+	injected := make(chan error, 1)
+	go func() {
+		for i := 0; i < sessionDownlinkFrames*2; i++ {
+			raw, err := EncodeFrame(Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: payload})
+			if err != nil {
+				injected <- err
+				return
+			}
+			if _, err := carrier.serverWriter.Write(raw); err != nil {
+				injected <- err
+				return
+			}
+		}
+		raw, err := EncodeFrame(Frame{SessionID: 2, Status: StatusKeep, Option: OptionData, Payload: []byte("fast")})
+		if err != nil {
+			injected <- err
+			return
+		}
+		_, err = carrier.serverWriter.Write(raw)
+		injected <- err
+	}()
+
+	_ = fast.SetReadDeadline(time.Now().Add(5 * time.Second))
+	got := make([]byte, len("fast"))
+	if _, err := io.ReadFull(fast, got); err != nil {
+		t.Fatalf("sibling read while another consumer stalled: %v", err)
+	}
+	if string(got) != "fast" {
+		t.Fatalf("sibling payload = %q", got)
+	}
+	if err := <-injected; err != nil {
+		t.Fatalf("inject frames: %v", err)
+	}
+
+	_ = slow.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := slow.Read(make([]byte, 1)); !errors.Is(err, ErrSessionOverflow) {
+		t.Fatalf("slow session read error = %v, want %v", err, ErrSessionOverflow)
+	}
+	if carrier.isClosed() {
+		t.Fatal("one overflowing session closed the carrier")
+	}
+	waitFor(t, func() bool { return worker.activeSessions() == 1 })
+}
+
+func TestCarrierDownlinkBudgetResetsOnlyThePushingSession(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	worker.maxBuffered.Store(300 * 1024)
+	t.Cleanup(func() { worker.close(nil) })
+
+	first, err := worker.openSession(context.Background(), "first.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = first.Close() })
+	second, err := worker.openSession(context.Background(), "second.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = second.Close() })
+
+	// Neither consumer reads. The first session takes 200 KiB, the second
+	// one crosses the 300 KiB carrier budget and resets; the first keeps
+	// its queued data.
+	payload := bytes.Repeat([]byte{0x11}, MaxPayloadSize)
+	frames := make([]Frame, 0, 55)
+	for i := 0; i < 25; i++ {
+		frames = append(frames, Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: payload})
+	}
+	for i := 0; i < 30; i++ {
+		frames = append(frames, Frame{SessionID: 2, Status: StatusKeep, Option: OptionData, Payload: payload})
+	}
+	for _, frame := range frames {
+		carrier.inject(t, frame)
+	}
+
+	_ = second.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := second.Read(make([]byte, 1)); !errors.Is(err, ErrSessionOverflow) {
+		t.Fatalf("second session read error = %v, want %v", err, ErrSessionOverflow)
+	}
+
+	_ = first.SetReadDeadline(time.Now().Add(time.Second))
+	got := make([]byte, len(payload))
+	if _, err := io.ReadFull(first, got); err != nil {
+		t.Fatalf("first session read: %v", err)
+	}
+	if !bytes.Equal(got, payload) {
+		t.Fatal("first session payload changed")
+	}
+}
+
+func TestPacketSessionDeliversQueuedDatagramsBeforeRemoteEnd(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	t.Cleanup(func() { worker.close(nil) })
+	packetConn, err := worker.openPacketSession("8.8.8.8", 53, [8]byte{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = packetConn.Close() })
+
+	for _, payload := range []string{"one", "two"} {
+		carrier.inject(t, Frame{
+			SessionID: 1, Status: StatusKeep, Option: OptionData, Network: NetworkUDP,
+			Destination: "1.1.1.1", Port: 53, Payload: []byte(payload),
+		})
+	}
+	carrier.inject(t, Frame{SessionID: 1, Status: StatusEnd})
+
+	buffer := make([]byte, 8)
+	for _, want := range []string{"one", "two"} {
+		n, _, err := packetConn.ReadFrom(buffer)
+		if err != nil {
+			t.Fatalf("read %q: %v", want, err)
+		}
+		if string(buffer[:n]) != want {
+			t.Fatalf("datagram = %q, want %q", buffer[:n], want)
+		}
+	}
+	if _, _, err := packetConn.ReadFrom(buffer); !errors.Is(err, net.ErrClosed) {
+		t.Fatalf("read after End = %v, want net.ErrClosed", err)
+	}
+}
+
+func TestPacketSessionExpiredDeadlineWinsOverQueuedData(t *testing.T) {
+	owner := newFakeSessionOwner()
+	packetConn, session := newPacketSession(owner, 41, "deadline.example", 53, [8]byte{})
+	t.Cleanup(func() { _ = packetConn.Close() })
+
+	if err := session.deliverFrame(Frame{
+		SessionID: 41, Status: StatusKeep, Option: OptionData, Network: NetworkUDP,
+		Destination: "1.1.1.1", Port: 53, Payload: []byte("queued"),
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if err := packetConn.SetReadDeadline(time.Now().Add(-time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := packetConn.ReadFrom(make([]byte, 8)); !isTimeout(err) {
+		t.Fatalf("ReadFrom with expired deadline = %v, want timeout", err)
+	}
+	if err := packetConn.SetReadDeadline(time.Time{}); err != nil {
+		t.Fatal(err)
+	}
+	buffer := make([]byte, 8)
+	n, _, err := packetConn.ReadFrom(buffer)
+	if err != nil || string(buffer[:n]) != "queued" {
+		t.Fatalf("ReadFrom after clearing deadline = (%q, %v)", buffer[:n], err)
+	}
+}
+
+func TestByteQueueReleasesDroppedAndSealedItems(t *testing.T) {
+	var released atomic.Int64
+	queue := newByteQueue(func(int) int { return 1 }, func(int) { released.Add(1) }, 2, 2)
+
+	for i := 0; i < 2; i++ {
+		if err := queue.push(i); err != nil {
+			t.Fatalf("push %d: %v", i, err)
+		}
+	}
+	if err := queue.push(2); !errors.Is(err, errQueueOverflow) {
+		t.Fatalf("push over budget = %v, want overflow", err)
+	}
+	if got := released.Load(); got != 1 {
+		t.Fatalf("released after overflow = %d, want 1", got)
+	}
+
+	dropped := queue.seal(true)
+	if len(dropped) != 2 {
+		t.Fatalf("seal returned %d items, want 2", len(dropped))
+	}
+	for _, item := range dropped {
+		_ = item
+	}
+	if err := queue.push(3); !errors.Is(err, errQueueClosed) {
+		t.Fatalf("push after seal = %v, want closed", err)
+	}
+	if got := released.Load(); got != 2 {
+		t.Fatalf("released after closed push = %d, want 2", got)
+	}
+	if _, err := queue.wait(nil); !errors.Is(err, errQueueClosed) {
+		t.Fatalf("wait on sealed queue = %v, want closed", err)
+	}
+}
+
+func TestByteQueueDrainsSealedItemsBeforeClosing(t *testing.T) {
+	queue := newByteQueue(func(int) int { return 1 }, func(int) {}, 8, 8)
+	for i := 0; i < 2; i++ {
+		if err := queue.push(i); err != nil {
+			t.Fatal(err)
+		}
+	}
+	queue.seal(false)
+	for i := 0; i < 2; i++ {
+		item, err := queue.wait(nil)
+		if err != nil || item != i {
+			t.Fatalf("wait %d = (%d, %v)", i, item, err)
+		}
+	}
+	if _, err := queue.wait(nil); !errors.Is(err, errQueueClosed) {
+		t.Fatalf("wait after drain = %v, want closed", err)
+	}
+}
