+
+func (q *byteQueue[T]) popLocked() (T, bool) {
+	if len(q.items) == 0 {
+		var zero T
+		return zero, false
+	}
+	item := q.items[0]
+	var zero T
+	q.items[0] = zero
+	q.items = q.items[1:]
+	size := q.sizeOf(item)
+	q.bytes -= size
+	if q.credit != nil && size > 0 {
+		q.credit(size)
+	}
+	return item, true
+}
+
+func (q *byteQueue[T]) pop() (T, bool) {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	return q.popLocked()
+}
+
+// wait returns the next item, blocking until one is queued, the queue is
+// sealed and drained (errQueueClosed), or the deadline fires. A queued item
+// is delivered even when the deadline has already passed, matching a network
+// read that started before the deadline.
+func (q *byteQueue[T]) wait(d *deadline.PipeDeadline) (T, error) {
+	for {
+		q.mu.Lock()
+		if item, ok := q.popLocked(); ok {
+			q.mu.Unlock()
+			return item, nil
+		}
+		if q.closed {
+			q.mu.Unlock()
+			var zero T
+			return zero, errQueueClosed
+		}
+		notify := q.notify
+		q.mu.Unlock()
