-func checkMuxCool(mapping map[string]any, decoder *structure.Decoder) error {
+// applyMuxCoolAliases maps Xray's camelCase mux keys onto the kebab options
+// Veles configs use. An explicit Xray key wins; absent keys leave the
+// historical meaning untouched. `concurrency: 0` is Xray's "no TCP pool",
+// which is also the only form that may carry XUDP under a Vision flow.
+func applyMuxCoolAliases(mapping map[string]any, option *outbound.MuxCoolOption) error {
+	if value, ok := mapping["concurrency"]; ok {
+		concurrency, err := muxCoolInt(value)
+		if err != nil {
+			return fmt.Errorf("concurrency: %w", err)
+		}
+		if concurrency < 0 {
+			return fmt.Errorf("concurrency must not be negative")
+		}
+		if concurrency == 0 {
+			option.TCPDisabled = true
+		} else {
+			option.MaxConcurrency = concurrency
+		}
+	}
+	if value, ok := mapping["xudpConcurrency"]; ok {
+		concurrency, err := muxCoolInt(value)
+		if err != nil {
+			return fmt.Errorf("xudpConcurrency: %w", err)
+		}
+		if concurrency < 0 {
+			return fmt.Errorf("xudpConcurrency must not be negative")
+		}
+		option.XUDPConcurrency = concurrency
+	}
+	if value, ok := mapping["xudpProxyUDP443"]; ok {
+		policy, ok := value.(string)
+		if !ok {
+			return fmt.Errorf("xudpProxyUDP443 must be a string")
+		}
+		option.XUDPProxyUDP443 = policy
+	}
+	return nil
+}
+
+func muxCoolInt(value any) (int, error) {
+	switch typed := value.(type) {
+	case int:
+		return typed, nil
+	case int64:
+		return int(typed), nil
+	case float64:
+		if typed != float64(int(typed)) {
+			return 0, fmt.Errorf("not an integer: %v", typed)
+		}
+		return int(typed), nil
+	case string:
+		parsed, err := strconv.Atoi(strings.TrimSpace(typed))
+		if err != nil {
+			return 0, fmt.Errorf("not an integer: %q", typed)
+		}
+		return parsed, nil
+	default:
+		return 0, fmt.Errorf("not an integer: %T", value)
+	}
+}
