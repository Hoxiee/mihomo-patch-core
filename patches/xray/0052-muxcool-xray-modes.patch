+func TestMuxCoolTCPDisabledDelegatesTCPAndPoolsUDP(t *testing.T) {
+	base := newFakeMuxCoolAdapter()
+	wrapped, err := NewMuxCool(MuxCoolOption{Enabled: true, TCPDisabled: true, XUDPConcurrency: 2}, base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = wrapped.Close() })
+
+	stream, err := wrapped.DialContext(context.Background(), &C.Metadata{NetWork: C.TCP, Host: "plain.example", DstPort: 443})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = stream.Close() })
+	base.mu.Lock()
+	tcpMetadata := base.dialMetadata[0]
+	base.mu.Unlock()
+	if tcpMetadata.Host != "plain.example" || tcpMetadata.DstPort != 443 {
+		t.Fatalf("TCP dial metadata = %+v, want the real target", tcpMetadata)
+	}
+	server := <-base.carrierServers
+	_ = server.Close()
+
+	metadata := &C.Metadata{
+		NetWork: C.UDP, Host: "dns.example", DstPort: 53,
+		SrcIP: netip.MustParseAddr("192.0.2.10"), SrcPort: 4242,
+	}
+	packetConn, err := wrapped.ListenPacketContext(context.Background(), metadata)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = packetConn.Close() })
+	carrierServer := <-base.carrierServers
+	t.Cleanup(func() { _ = carrierServer.Close() })
+
+	base.mu.Lock()
+	carrierMetadata := base.dialMetadata[1]
+	base.mu.Unlock()
+	if carrierMetadata.Host != muxCoolDestination || carrierMetadata.DstPort != muxCoolPort {
+		t.Fatalf("UDP carrier metadata = %+v", carrierMetadata)
+	}
+
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := packetConn.WriteTo([]byte("query"), net.UDPAddrFromAddrPort(netip.MustParseAddrPort("8.8.8.8:53")))
+		writeDone <- err
+	}()
+	frame, err := muxcool.DecodeFrame(carrierServer)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := <-writeDone; err != nil {
+		t.Fatal(err)
+	}
+	if frame.Status != muxcool.StatusNew || frame.Network != muxcool.NetworkUDP || string(frame.Payload) != "query" {
+		t.Fatalf("UDP New frame = %+v", frame)
+	}
+	if !wrapped.ProxyInfo().XUDP {
+		t.Fatal("ProxyInfo XUDP = false with an XUDP pool")
+	}
+}
