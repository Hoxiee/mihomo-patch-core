@@ -0,0 +1,250 @@
+package muxcool
+
+import (
+	"context"
+	"math/rand/v2"
+	"net"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// The fault-injection harness for the mux.cool verification suite. A
+// faultConn wraps a carrier net.Conn and injects one deterministic class of
+// network trouble per scenario: latency, jitter, bandwidth throttling, a
+// temporary write stall, short writes, a partial write failure, or a peer
+// that stops reading. Carrier death (EOF, reset, blackhole) is produced by
+// the dialer that owns the peer side, because a real peer disappears by
+// closing the socket, not by returning a crafted error from Read.
+
+// faultSpec is immutable for the life of one faultConn: a scenario creates a
+// dialer whose spec function returns a fresh value per carrier, so every
+// carrier of one test sees the same fault.
+type faultSpec struct {
+	readDelay   time.Duration
+	writeDelay  time.Duration
+	jitter      time.Duration
+	seed        int64
+	shortWrite  int
+	stallWrites int
+	stallFor    time.Duration
+	failWrite   int
+	writeErr    error
+	readRate    int
+	writeRate   int
+}
+
+// tokenBucket throttles one direction to rate bytes per second with a burst
+// of one second. Tests use it to prove that a slow but live link still
+// completes a session instead of tripping the carrier write timeout.
+type tokenBucket struct {
+	mu     sync.Mutex
+	rate   float64
+	tokens float64
+	last   time.Time
+}
+
+func newTokenBucket(rate int) *tokenBucket {
+	if rate <= 0 {
+		return nil
+	}
+	return &tokenBucket{rate: float64(rate), tokens: float64(rate), last: time.Now()}
+}
+
+func (b *tokenBucket) wait(n int) {
+	if b == nil || n <= 0 {
+		return
+	}
+	b.mu.Lock()
+	now := time.Now()
+	b.tokens += now.Sub(b.last).Seconds() * b.rate
+	if b.tokens > b.rate {
+		b.tokens = b.rate
+	}
+	b.last = now
+	b.tokens -= float64(n)
+	var sleep time.Duration
+	if b.tokens < 0 {
+		sleep = time.Duration(-b.tokens / b.rate * float64(time.Second))
+		b.tokens = 0
+	}
+	b.mu.Unlock()
+	if sleep > 0 {
+		time.Sleep(sleep)
+	}
+}
+
+type faultConn struct {
+	net.Conn
+	spec        faultSpec
+	rngMu       sync.Mutex
+	rng         *rand.Rand
+	writes      atomic.Int64
+	readBucket  *tokenBucket
+	writeBucket *tokenBucket
+}
+
+func newFaultConn(conn net.Conn, spec faultSpec) *faultConn {
+	c := &faultConn{
+		Conn:        conn,
+		spec:        spec,
+		readBucket:  newTokenBucket(spec.readRate),
+		writeBucket: newTokenBucket(spec.writeRate),
+	}
+	if spec.jitter > 0 {
+		seed := spec.seed
+		if seed == 0 {
+			seed = 1
+		}
+		c.rng = rand.New(rand.NewPCG(uint64(seed), uint64(seed)^0x9e3779b97f4a7c15))
+	}
+	return c
+}
+
+func (c *faultConn) delay(base time.Duration) {
+	if base <= 0 && c.rng == nil {
+		return
+	}
+	delay := base
+	if c.rng != nil && c.spec.jitter > 0 {
+		c.rngMu.Lock()
+		delay += time.Duration(c.rng.Int64N(int64(c.spec.jitter) + 1))
+		c.rngMu.Unlock()
+	}
+	if delay > 0 {
+		time.Sleep(delay)
+	}
+}
+
+func (c *faultConn) Read(p []byte) (int, error) {
+	c.delay(c.spec.readDelay)
+	if c.readBucket != nil {
+		c.readBucket.wait(len(p))
+	}
+	return c.Conn.Read(p)
+}
+
+func (c *faultConn) Write(p []byte) (int, error) {
+	c.delay(c.spec.writeDelay)
+	if c.writeBucket != nil {
+		c.writeBucket.wait(len(p))
+	}
+	index := c.writes.Add(1)
+	if c.spec.stallWrites > 0 && index <= int64(c.spec.stallWrites) && c.spec.stallFor > 0 {
+		// The worker already set its frame deadline on the underlying conn.
+		// Sleeping past it is what a peer window that never opens looks like:
+		// the physical write then fails with os.ErrDeadlineExceeded.
+		time.Sleep(c.spec.stallFor)
+	}
+	if c.spec.failWrite > 0 && index == int64(c.spec.failWrite) {
+		n := len(p) / 2
+		if n == 0 {
+			n = 1
+		}
+		return n, c.spec.writeErr
+	}
+	if c.spec.shortWrite > 0 && len(p) > c.spec.shortWrite {
+		return c.Conn.Write(p[:c.spec.shortWrite])
+	}
+	return c.Conn.Write(p)
+}
+
+type faultDialerMode int
+
+const (
+	// faultEchoTCP serves raw mux.cool frames back on the peer side.
+	faultEchoTCP faultDialerMode = iota
+	// faultEchoUDP serves raw XUDP frames back on the peer side.
+	faultEchoUDP
+	// faultBlackhole accepts the carrier and then neither reads nor writes,
+	// which is what a peer behind a dropped route looks like.
+	faultBlackhole
+)
+
+// faultDialer owns the peer side of every carrier it dials so a test can kill
+// a carrier the way a server does: by closing its socket.
+type faultDialer struct {
+	mode faultDialerMode
+	spec func() faultSpec
+
+	mu      sync.Mutex
+	calls   int
+	servers []net.Conn
+	clients []net.Conn
+	dialErr error
+}
+
+func (d *faultDialer) dial(context.Context) (net.Conn, error) {
+	d.mu.Lock()
+	d.calls++
+	if d.dialErr != nil {
+		err := d.dialErr
+		d.mu.Unlock()
+		return nil, err
+	}
+	d.mu.Unlock()
+
+	client, server := net.Pipe()
+	switch d.mode {
+	case faultEchoTCP:
+		go serveIndependentEcho(server)
+	case faultEchoUDP:
+		go serveIndependentPacketEcho(server, nil)
+	case faultBlackhole:
+		// Nobody touches the peer side; Read blocks, Write blocks until the
+		// writer's own deadline fires.
+	}
+
+	spec := faultSpec{}
+	if d.spec != nil {
+		spec = d.spec()
+	}
+	faulty := newFaultConn(client, spec)
+
+	d.mu.Lock()
+	d.servers = append(d.servers, server)
+	d.clients = append(d.clients, faulty)
+	d.mu.Unlock()
+	return faulty, nil
+}
+
+func (d *faultDialer) callCount() int {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	return d.calls
+}
+
+// killOldest closes up to n peer sockets. The oldest carrier is the one a
+// rotation or a server restart takes down first.
+func (d *faultDialer) killOldest(n int) int {
+	d.mu.Lock()
+	if n > len(d.servers) {
+		n = len(d.servers)
+	}
+	victims := append([]net.Conn(nil), d.servers[:n]...)
+	d.servers = d.servers[n:]
+	d.mu.Unlock()
+	for _, victim := range victims {
+		_ = victim.Close()
+	}
+	return len(victims)
+}
+
+func (d *faultDialer) closeServers() {
+	d.mu.Lock()
+	servers := d.servers
+	d.servers = nil
+	d.mu.Unlock()
+	for _, server := range servers {
+		_ = server.Close()
+	}
+}
+
+func faultPoolOptions() Options {
+	return Options{
+		MaxConcurrency:      8,
+		MaxConnections:      128,
+		FirstPayloadTimeout: 100 * time.Millisecond,
+		IdleTimeout:         time.Hour,
+	}
+}
