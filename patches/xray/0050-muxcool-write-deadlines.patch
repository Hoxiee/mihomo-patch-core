+func (w *carrierWorker) acquireWrite(deadline time.Time) (time.Time, error) {
+	if timeout := time.Duration(w.writeTimeout.Load()); timeout > 0 {
+		limit := time.Now().Add(timeout)
+		if deadline.IsZero() || deadline.After(limit) {
+			deadline = limit
+		}
+	}
+	if !deadline.IsZero() && !time.Now().Before(deadline) {
+		return deadline, os.ErrDeadlineExceeded
+	}
+	if deadline.IsZero() {
+		select {
+		case <-w.writeToken:
+			return deadline, nil
+		case <-w.closedCh:
+			return deadline, w.closeCause()
+		}
+	}
+	timer := time.NewTimer(time.Until(deadline))
+	defer timer.Stop()
+	select {
+	case <-w.writeToken:
+		return deadline, nil
+	case <-timer.C:
+		return deadline, os.ErrDeadlineExceeded
+	case <-w.closedCh:
+		return deadline, w.closeCause()
+	}
+}
