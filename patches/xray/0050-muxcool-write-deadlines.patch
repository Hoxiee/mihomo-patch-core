+// writeSignalConn reports the first physical write so a test can wait until
+// a frame is actually in flight.
+type writeSignalConn struct {
+	net.Conn
+	once    sync.Once
+	entered chan struct{}
+}
+
+func (c *writeSignalConn) Write(p []byte) (int, error) {
+	c.once.Do(func() { close(c.entered) })
+	return c.Conn.Write(p)
+}
+
+func TestCarrierWriteTimeoutClosesStalledCarrier(t *testing.T) {
+	client, server := net.Pipe()
+	t.Cleanup(func() { _ = server.Close() })
+	carrier := &writeSignalConn{Conn: client, entered: make(chan struct{})}
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	worker.writeTimeout.Store(int64(20 * time.Millisecond))
+	t.Cleanup(func() { worker.close(nil) })
+
+	conn, err := worker.openSession(context.Background(), "stalled.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+
+	writeDone := make(chan error, 1)
+	go func() {
+		_, err := conn.Write([]byte("payload"))
+		writeDone <- err
+	}()
+	select {
+	case <-carrier.entered:
+	case <-time.After(time.Second):
+		t.Fatal("carrier write did not start")
+	}
+
+	_ = conn.SetReadDeadline(time.Now().Add(2 * time.Second))
+	start := time.Now()
+	_, err = conn.Read(make([]byte, 1))
+	if !errors.Is(err, ErrCarrierWriteTimeout) {
+		t.Fatalf("read error = %v, want %v", err, ErrCarrierWriteTimeout)
+	}
+	if elapsed := time.Since(start); elapsed > time.Second {
+		t.Fatalf("carrier timeout took %v", elapsed)
+	}
+	select {
+	case <-writeDone:
+	case <-time.After(time.Second):
+		t.Fatal("uplink write did not return after the carrier failed")
+	}
+}
+
+func TestPacketWriteDeadlineBoundsCarrierTurnWait(t *testing.T) {
+	client, server := net.Pipe()
+	t.Cleanup(func() { _ = server.Close() })
+	carrier := &writeSignalConn{Conn: client, entered: make(chan struct{})}
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	worker.writeTimeout.Store(int64(5 * time.Second))
+	t.Cleanup(func() { worker.close(nil) })
+
+	blocking, err := worker.openPacketSession("a.example", 53, [8]byte{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = blocking.Close() })
+	waiting, err := worker.openPacketSession("b.example", 53, [8]byte{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = waiting.Close() })
+
+	target := net.UDPAddrFromAddrPort(netip.MustParseAddrPort("1.1.1.1:53"))
+	firstDone := make(chan error, 1)
+	go func() {
+		_, err := blocking.WriteTo([]byte("first"), target)
+		firstDone <- err
+	}()
+	select {
+	case <-carrier.entered:
+	case <-time.After(time.Second):
+		t.Fatal("first packet write did not reach the carrier")
+	}
+
+	if err := waiting.SetWriteDeadline(time.Now().Add(20 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	start := time.Now()
+	if _, err := waiting.WriteTo([]byte("second"), target); !errors.Is(err, os.ErrDeadlineExceeded) {
+		t.Fatalf("WriteTo while carrier turn is held = %v, want deadline exceeded", err)
+	}
+	if elapsed := time.Since(start); elapsed > time.Second {
+		t.Fatalf("deadline wait took %v", elapsed)
+	}
+	if worker.closedFast.Load() {
+		t.Fatal("a deadline while waiting for the write turn closed the carrier")
+	}
+
+	worker.close(nil)
+	select {
+	case <-firstDone:
+	case <-time.After(time.Second):
+		t.Fatal("first packet write did not unblock on carrier close")
+	}
+}
+
+func TestPacketWriteDeadlineDuringPhysicalWriteClosesCarrier(t *testing.T) {
+	client, server := net.Pipe()
+	t.Cleanup(func() { _ = server.Close() })
+	carrier := &writeSignalConn{Conn: client, entered: make(chan struct{})}
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	worker.writeTimeout.Store(int64(5 * time.Second))
+	t.Cleanup(func() { worker.close(nil) })
+
+	packetConn, err := worker.openPacketSession("deadline.example", 53, [8]byte{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = packetConn.Close() })
+
+	target := net.UDPAddrFromAddrPort(netip.MustParseAddrPort("1.1.1.1:53"))
+	if err := packetConn.SetWriteDeadline(time.Now().Add(20 * time.Millisecond)); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := packetConn.WriteTo([]byte("stalled"), target); !errors.Is(err, ErrCarrierWriteTimeout) {
+		t.Fatalf("WriteTo = %v, want %v", err, ErrCarrierWriteTimeout)
+	}
+	waitFor(t, func() bool { return worker.closedFast.Load() })
+}
+
+func TestCarrierPartialWriteClosesCarrier(t *testing.T) {
+	writeErr := errors.New("short write")
+	conn := newPartialWriteConn(writeErr)
+	worker := newCarrierWorker(conn, 8, 128, nil)
+	t.Cleanup(func() { worker.close(nil) })
+
+	stream, err := worker.openSession(context.Background(), "partial.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = stream.Close() })
+
+	if _, err := stream.Write([]byte("payload")); err != nil {
+		t.Fatalf("stream write: %v", err)
+	}
+	_ = stream.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := stream.Read(make([]byte, 1)); !errors.Is(err, writeErr) {
+		t.Fatalf("read error = %v, want %v", err, writeErr)
+	}
+	waitFor(t, func() bool { return conn.closed.Load() })
+}
+
+// partialWriteConn writes half a frame and reports an error, as a broken
+// carrier does; the worker must close it rather than resume mid-frame.
+type partialWriteConn struct {
+	writeErr error
+	closed   atomic.Bool
+	done     chan struct{}
+	once     sync.Once
+}
+
+func newPartialWriteConn(writeErr error) *partialWriteConn {
+	return &partialWriteConn{writeErr: writeErr, done: make(chan struct{})}
+}
+
+func (c *partialWriteConn) Read([]byte) (int, error) {
+	<-c.done
+	return 0, net.ErrClosed
+}
+
+func (c *partialWriteConn) Write(p []byte) (int, error) {
+	n := len(p) / 2
+	if n == 0 {
+		n = 1
+	}
+	return n, c.writeErr
+}
+
+func (c *partialWriteConn) Close() error {
+	c.once.Do(func() {
+		c.closed.Store(true)
+		close(c.done)
+	})
+	return nil
+}
+
+func (c *partialWriteConn) LocalAddr() net.Addr              { return muxAddr("partial") }
+func (c *partialWriteConn) RemoteAddr() net.Addr             { return muxAddr("partial") }
+func (c *partialWriteConn) SetDeadline(time.Time) error      { return nil }
+func (c *partialWriteConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *partialWriteConn) SetWriteDeadline(time.Time) error { return nil }
