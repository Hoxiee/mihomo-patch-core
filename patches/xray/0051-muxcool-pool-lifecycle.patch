index 41394ce..16a62aa 100644
--- a/transport/muxcool/carrier_limiter.go
+++ b/transport/muxcool/carrier_limiter.go
@@ -6,18 +6,49 @@ import (
 )
 
 // CarrierLimiter enforces a shared upper bound on physical mux.cool carriers.
-// A zero limit preserves the existing unlimited behavior.
+// A zero limit preserves the existing unlimited behavior. Pools that share a
+// limiter register here so a waiter can reclaim capacity from an idle carrier
+// in another pool instead of waiting for its idle timer.
 type CarrierLimiter struct {
 	mu      sync.Mutex
 	max     int
 	used    int
 	changed chan struct{}
+	pools   map[*Pool]struct{}
 }
 
 func NewCarrierLimiter(maxCarriers int) *CarrierLimiter {
 	return &CarrierLimiter{
 		max:     maxCarriers,
 		changed: make(chan struct{}),
+		pools:   make(map[*Pool]struct{}),
+	}
+}
+
+func (l *CarrierLimiter) register(pool *Pool) {
+	l.mu.Lock()
+	l.pools[pool] = struct{}{}
+	l.mu.Unlock()
+}
+
+func (l *CarrierLimiter) unregister(pool *Pool) {
+	l.mu.Lock()
+	delete(l.pools, pool)
+	l.mu.Unlock()
+}
+
+// closeIdle asks every registered pool to close its carriers without
+// sessions. The snapshot is taken under the limiter lock; the pools close
+// their carriers outside it so their callbacks can re-enter the limiter.
+func (l *CarrierLimiter) closeIdle() {
+	l.mu.Lock()
+	pools := make([]*Pool, 0, len(l.pools))
+	for pool := range l.pools {
+		pools = append(pools, pool)
+	}
+	l.mu.Unlock()
+	for _, pool := range pools {
+		pool.closeIdle()
 	}
 }
 
