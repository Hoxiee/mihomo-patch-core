+
+// A caller whose own context expires must not abort the carrier dial that
+// other callers are still waiting on.
+func TestCanceledInitiatorDoesNotAbortSharedCarrierDial(t *testing.T) {
+	dialer := newBlockingCarrierDialer()
+	pool := NewPool(dialer.dial, testPoolOptions())
+	t.Cleanup(func() { _ = pool.Close() })
+
+	ctxA, cancelA := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancelA()
+	resultA := make(chan error, 1)
+	go func() {
+		_, err := pool.DialContext(ctxA, "first.example", 80)
+		resultA <- err
+	}()
+	select {
+	case <-dialer.started:
+	case <-time.After(time.Second):
+		t.Fatal("carrier dial did not start")
+	}
+	select {
+	case <-ctxA.Done():
+	case <-time.After(time.Second):
+		t.Fatal("first caller context did not expire")
+	}
+	select {
+	case err := <-resultA:
+		if !errors.Is(err, context.DeadlineExceeded) {
+			t.Fatalf("expired caller error = %v, want deadline exceeded", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("expired caller did not return")
+	}
+
+	// The second caller joins while the physical dial is still in flight.
+	resultB := make(chan net.Conn, 1)
+	errorsB := make(chan error, 1)
+	go func() {
+		conn, err := pool.DialContext(context.Background(), "second.example", 80)
+		if err != nil {
+			errorsB <- err
+			return
+		}
+		resultB <- conn
+	}()
+	time.Sleep(20 * time.Millisecond)
+
+	close(dialer.release)
+
+	select {
+	case conn := <-resultB:
+		_ = conn.Close()
+	case err := <-errorsB:
+		t.Fatalf("second caller failed: %v", err)
+	case <-time.After(time.Second):
+		t.Fatal("second caller did not open a session on the shared carrier")
+	}
+	if got := dialer.callCount(); got != 1 {
+		t.Fatalf("carrier dials = %d, want 1", got)
+	}
+}
+
+func TestCarrierLimiterReclaimsIdleCarrierOfAnotherPool(t *testing.T) {
+	previous := idleReclaimGrace
+	idleReclaimGrace = 10 * time.Millisecond
+	t.Cleanup(func() { idleReclaimGrace = previous })
+
+	dialer := &fakeCarrierDialer{}
+	limiter := NewCarrierLimiter(1)
+	options := testPoolOptions()
+	options.MaxConcurrency = 1
+	options.CarrierLimiter = limiter
+	tcpPool := NewPool(dialer.dial, options)
+	udpPool := NewPool(dialer.dial, options)
+	t.Cleanup(func() { _ = tcpPool.Close(); _ = udpPool.Close() })
+
+	stream, err := tcpPool.DialContext(context.Background(), "tcp.example", 80)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := stream.Close(); err != nil {
+		t.Fatal(err)
+	}
+	waitFor(t, func() bool { return tcpPool.activeSessions() == 0 })
+	time.Sleep(20 * time.Millisecond)
+
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	packetConn, err := udpPool.ListenPacketContext(ctx, "udp.example", 53, [8]byte{})
+	if err != nil {
+		t.Fatalf("UDP pool waited for the idle TCP carrier: %v", err)
+	}
+	defer packetConn.Close()
+	if got := dialer.callCount(); got != 2 {
+		t.Fatalf("carrier dials = %d, want 2", got)
+	}
+	if got := tcpPool.workerCount(); got != 0 {
+		t.Fatalf("idle TCP carriers after reclaim = %d, want 0", got)
+	}
+}
+
+func TestPoolDoesNotStormCarrierDialsAfterRepeatedFailures(t *testing.T) {
+	dialErr := errors.New("carrier unavailable")
+	var calls atomic.Int32
+	pool := NewPool(func(context.Context) (net.Conn, error) {
+		calls.Add(1)
+		return nil, dialErr
+	}, testPoolOptions())
+	t.Cleanup(func() { _ = pool.Close() })
+
+	if _, err := pool.DialContext(context.Background(), "first.example", 80); !errors.Is(err, dialErr) {
+		t.Fatalf("first dial error = %v, want %v", err, dialErr)
+	}
+
+	const callers = 32
+	var wg sync.WaitGroup
+	results := make(chan error, callers)
+	for i := 0; i < callers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			_, err := pool.DialContext(context.Background(), "storm.example", 80)
+			results <- err
+		}()
+	}
+	wg.Wait()
+	close(results)
+	for err := range results {
+		if !errors.Is(err, dialErr) {
+			t.Fatalf("storm dial error = %v, want %v", err, dialErr)
+		}
+	}
+	if got := calls.Load(); got > 2 {
+		t.Fatalf("carrier dials during a failure storm = %d, want at most 2", got)
+	}
+}
