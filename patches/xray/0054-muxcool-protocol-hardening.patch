+package muxcool
+
+import (
+	"bytes"
+	"context"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+// discardConn is a carrier whose writes complete at once and whose reads
+// block until close. It isolates codec and session overhead from the network.
+type discardConn struct {
+	once   sync.Once
+	closed chan struct{}
+}
+
+func newDiscardConn() *discardConn {
+	return &discardConn{closed: make(chan struct{})}
+}
+
+func (c *discardConn) Read([]byte) (int, error) {
+	<-c.closed
+	return 0, net.ErrClosed
+}
+
+func (c *discardConn) Write(p []byte) (int, error) { return len(p), nil }
+
+func (c *discardConn) Close() error {
+	c.once.Do(func() { close(c.closed) })
+	return nil
+}
+
+func (c *discardConn) LocalAddr() net.Addr              { return muxAddr("bench") }
+func (c *discardConn) RemoteAddr() net.Addr             { return muxAddr("bench") }
+func (c *discardConn) SetDeadline(time.Time) error      { return nil }
+func (c *discardConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *discardConn) SetWriteDeadline(time.Time) error { return nil }
+
+func benchmarkPayload() []byte {
+	return bytes.Repeat([]byte{0x5a}, MaxPayloadSize)
+}
+
+func BenchmarkEncodeKeepData(b *testing.B) {
+	frame := Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: benchmarkPayload()}
+	b.ReportAllocs()
+	b.SetBytes(int64(len(frame.Payload)))
+	for i := 0; i < b.N; i++ {
+		if _, err := EncodeFrame(frame); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func BenchmarkDecodeKeepData(b *testing.B) {
+	raw, err := EncodeFrame(Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: benchmarkPayload()})
+	if err != nil {
+		b.Fatal(err)
+	}
+	b.ReportAllocs()
+	b.SetBytes(int64(len(raw)))
+	for i := 0; i < b.N; i++ {
+		if _, err := DecodeFrame(bytes.NewReader(raw)); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func BenchmarkCarrierWriteFrame(b *testing.B) {
+	worker := newCarrierWorker(newDiscardConn(), 128, 1<<30, nil)
+	b.Cleanup(func() { worker.close(nil) })
+	frame := Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: benchmarkPayload()}
+	b.ReportAllocs()
+	b.SetBytes(int64(len(frame.Payload)))
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		if err := worker.writeFrame(frame); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func BenchmarkPoolDialAndClose(b *testing.B) {
+	pool := NewPool(func(context.Context) (net.Conn, error) {
+		return newDiscardConn(), nil
+	}, Options{
+		MaxConcurrency:      128,
+		MaxConnections:      1 << 30,
+		FirstPayloadTimeout: time.Hour,
+		IdleTimeout:         time.Hour,
+	})
+	b.Cleanup(func() { _ = pool.Close() })
+	b.ReportAllocs()
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		conn, err := pool.DialContext(context.Background(), "bench.example", 443)
+		if err != nil {
+			b.Fatal(err)
+		}
+		if err := conn.Close(); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
+
+func BenchmarkStreamWriteEightKiB(b *testing.B) {
+	pool := NewPool(func(context.Context) (net.Conn, error) {
+		return newDiscardConn(), nil
+	}, Options{
+		MaxConcurrency:      8,
+		MaxConnections:      1 << 30,
+		FirstPayloadTimeout: time.Hour,
+		IdleTimeout:         time.Hour,
+	})
+	b.Cleanup(func() { _ = pool.Close() })
+	conn, err := pool.DialContext(context.Background(), "bench.example", 443)
+	if err != nil {
+		b.Fatal(err)
+	}
+	b.Cleanup(func() { _ = conn.Close() })
+	payload := benchmarkPayload()
+	b.ReportAllocs()
+	b.SetBytes(int64(len(payload)))
+	b.ResetTimer()
+	for i := 0; i < b.N; i++ {
+		if _, err := conn.Write(payload); err != nil {
+			b.Fatal(err)
+		}
+	}
+}
