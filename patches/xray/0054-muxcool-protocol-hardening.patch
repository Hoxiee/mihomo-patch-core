@@ -0,0 +1,272 @@
+package muxcool
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"testing"
+	"time"
+)
+
+func TestDecodeFrameAcceptsMaxDomainAndRejectsOverflow(t *testing.T) {
+	domain := string(bytes.Repeat([]byte{'a'}, 255))
+	raw, err := EncodeFrame(Frame{SessionID: 1, Status: StatusNew, Network: NetworkTCP, Destination: domain, Port: 443})
+	if err != nil {
+		t.Fatalf("encode max domain: %v", err)
+	}
+	frame, err := DecodeFrame(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatalf("decode max domain: %v", err)
+	}
+	if frame.Destination != domain {
+		t.Fatalf("domain length = %d, want 255", len(frame.Destination))
+	}
+	if _, err := EncodeFrame(Frame{SessionID: 1, Status: StatusNew, Network: NetworkTCP, Destination: domain + "a", Port: 443}); err == nil {
+		t.Fatal("encode accepted a 256-byte domain")
+	}
+}
+
+func TestDecodeFrameAcceptsMaxPayload(t *testing.T) {
+	payload := bytes.Repeat([]byte{0x7f}, int(^uint16(0)))
+	raw, err := EncodeFrame(Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: payload})
+	if err != nil {
+		t.Fatalf("encode max payload: %v", err)
+	}
+	frame, err := DecodeFrame(bytes.NewReader(raw))
+	if err != nil {
+		t.Fatalf("decode max payload: %v", err)
+	}
+	if !bytes.Equal(frame.Payload, payload) {
+		t.Fatalf("payload length = %d, want %d", len(frame.Payload), len(payload))
+	}
+	if _, err := EncodeFrame(Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: append(payload, 0)}); err == nil {
+		t.Fatal("encode accepted a payload above uint16")
+	}
+}
+
+func TestServerInitiatedNewIsIgnored(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	t.Cleanup(func() { worker.close(nil) })
+	conn, err := worker.openSession(context.Background(), "new.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+
+	carrier.inject(t, Frame{
+		SessionID: 1, Status: StatusNew, Option: OptionData, Network: NetworkTCP,
+		Destination: "spoof.example", Port: 443, Payload: []byte("ignored"),
+	})
+	carrier.inject(t, Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: []byte("real")})
+
+	_ = conn.SetReadDeadline(time.Now().Add(time.Second))
+	got := make([]byte, len("real"))
+	if _, err := io.ReadFull(conn, got); err != nil {
+		t.Fatalf("read after server New: %v", err)
+	}
+	if string(got) != "real" {
+		t.Fatalf("payload = %q, want the Keep payload", got)
+	}
+	if carrier.isClosed() {
+		t.Fatal("a server-initiated New closed the carrier")
+	}
+}
+
+func TestKeepAliveDoesNotDisturbSession(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	t.Cleanup(func() { worker.close(nil) })
+	conn, err := worker.openSession(context.Background(), "keepalive.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+
+	carrier.inject(t, Frame{SessionID: 1, Status: StatusKeepAlive})
+	carrier.inject(t, Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: []byte("after")})
+	_ = conn.SetReadDeadline(time.Now().Add(time.Second))
+	got := make([]byte, len("after"))
+	if _, err := io.ReadFull(conn, got); err != nil {
+		t.Fatalf("read after keepalive: %v", err)
+	}
+	if string(got) != "after" {
+		t.Fatalf("payload = %q", got)
+	}
+}
+
+func TestDataAfterEndKeepsCarrierAndSibling(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	t.Cleanup(func() { worker.close(nil) })
+	first, err := worker.openSession(context.Background(), "ended.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = first.Close() })
+	second, err := worker.openSession(context.Background(), "sibling.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = second.Close() })
+
+	carrier.inject(t, Frame{SessionID: 1, Status: StatusEnd})
+	carrier.inject(t, Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: []byte("late")})
+	carrier.inject(t, Frame{SessionID: 2, Status: StatusKeep, Option: OptionData, Payload: []byte("sibling")})
+
+	_ = second.SetReadDeadline(time.Now().Add(time.Second))
+	got := make([]byte, len("sibling"))
+	if _, err := io.ReadFull(second, got); err != nil {
+		t.Fatalf("sibling read: %v", err)
+	}
+	if string(got) != "sibling" {
+		t.Fatalf("sibling payload = %q", got)
+	}
+	if carrier.isClosed() {
+		t.Fatal("data after End closed the carrier")
+	}
+}
+
+func TestWorkerSessionIDExhaustion(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 1<<30, nil)
+	t.Cleanup(func() { worker.close(nil) })
+	worker.mu.Lock()
+	worker.nextID = uint32(^uint16(0)) - 1
+	worker.mu.Unlock()
+
+	conn, err := worker.openSession(context.Background(), "last.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+	worker.mu.Lock()
+	id := worker.nextID
+	draining := worker.draining
+	worker.mu.Unlock()
+	if id != uint32(^uint16(0)) || !draining {
+		t.Fatalf("last id = %d draining = %t", id, draining)
+	}
+	if _, err := worker.openSession(context.Background(), "overflow.example", 80, time.Hour); !errors.Is(err, errWorkerUnavailable) {
+		t.Fatalf("open after exhaustion = %v, want %v", err, errWorkerUnavailable)
+	}
+}
+
+// oneByteReader delivers the frame in single-byte reads, as a carrier can
+// under TLS record fragmentation.
+type oneByteReader struct {
+	raw []byte
+}
+
+func (r *oneByteReader) Read(p []byte) (int, error) {
+	if len(r.raw) == 0 {
+		return 0, io.EOF
+	}
+	p[0] = r.raw[0]
+	r.raw = r.raw[1:]
+	return 1, nil
+}
+
+func TestDecodeFrameHandlesFragmentedInput(t *testing.T) {
+	raw, err := EncodeFrame(Frame{
+		SessionID: 9, Status: StatusNew, Option: OptionData, Network: NetworkUDP,
+		Destination: "fragment.example", Port: 53, GlobalID: [8]byte{1, 2, 3},
+		Payload: []byte("payload"),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	frame, err := DecodeFrame(&oneByteReader{raw: raw})
+	if err != nil {
+		t.Fatalf("fragmented decode: %v", err)
+	}
+	if frame.SessionID != 9 || string(frame.Payload) != "payload" || frame.GlobalID != [8]byte{1, 2, 3} {
+		t.Fatalf("frame = %+v", frame)
+	}
+}
+
+// chunkReader returns both frames from one Read; the decoder must consume
+// exactly one frame and leave the rest for the next call.
+type chunkReader struct {
+	raw []byte
+}
+
+func (r *chunkReader) Read(p []byte) (int, error) {
+	if len(r.raw) == 0 {
+		return 0, io.EOF
+	}
+	n := copy(p, r.raw)
+	r.raw = r.raw[n:]
+	return n, nil
+}
+
+func TestDecodeFrameReadsOneFrameFromBufferedChunk(t *testing.T) {
+	first, err := EncodeFrame(Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: []byte("one")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := EncodeFrame(Frame{SessionID: 2, Status: StatusKeep, Option: OptionData, Payload: []byte("two")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	reader := &chunkReader{raw: append(first, second...)}
+	one, err := DecodeFrame(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	two, err := DecodeFrame(reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(one.Payload) != "one" || string(two.Payload) != "two" {
+		t.Fatalf("frames = %q, %q", one.Payload, two.Payload)
+	}
+}
+
+func TestWorkerCloseIsIdempotentAndEndsSessions(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	conn, err := worker.openSession(context.Background(), "close.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	worker.close(nil)
+	worker.close(errors.New("second close"))
+	_ = conn.SetReadDeadline(time.Now().Add(time.Second))
+	if _, err := conn.Read(make([]byte, 1)); err == nil {
+		t.Fatal("session survived carrier close")
+	}
+	if !carrier.isClosed() {
+		t.Fatal("carrier conn was not closed")
+	}
+	waitFor(t, func() bool { return worker.activeSessions() == 0 })
+}
+
+func TestSessionWriteAfterCarrierCloseFails(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	conn, err := worker.openSession(context.Background(), "write.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	worker.close(nil)
+	if _, err := conn.Write([]byte("late")); err == nil {
+		t.Fatal("write after carrier close succeeded")
+	}
+}
+
+func TestPacketWriteAfterCloseFails(t *testing.T) {
+	carrier := newTestCarrier()
+	worker := newCarrierWorker(carrier, 8, 128, nil)
+	t.Cleanup(func() { worker.close(nil) })
+	packetConn, err := worker.openPacketSession("udp.example", 53, [8]byte{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = packetConn.Close()
+	if _, err := packetConn.WriteTo([]byte("late"), &net.UDPAddr{IP: net.IPv4(1, 1, 1, 1), Port: 53}); err == nil {
+		t.Fatal("write after packet close succeeded")
+	}
+}
