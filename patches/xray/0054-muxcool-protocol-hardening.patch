+package muxcool
+
+import (
+	"bytes"
+	"encoding/hex"
+	"testing"
+)
+
+// FuzzDecodeFrame exercises the wire decoder with arbitrary server input. A
+// malformed frame must produce an error, never a panic or an unbounded
+// allocation; every frame that decodes must be re-encodable without panicking.
+func FuzzDecodeFrame(f *testing.F) {
+	for _, raw := range referenceFrames {
+		seed, err := hex.DecodeString(raw)
+		if err != nil {
+			f.Fatalf("decode seed: %v", err)
+		}
+		f.Add(seed)
+	}
+	for _, seed := range [][]byte{
+		{},
+		{0},
+		{0x02, 0x01},
+		{0, 4, 0, 1, 9, 0},
+		{0, 4, 0, 1, 1, 0},
+		{0, 0xff, 0xff},
+		{0, 4, 0, 1, 2, 1},
+		{0, 4, 0, 1, 3, 0, 0xff, 0xff},
+	} {
+		f.Add(seed)
+	}
+	f.Fuzz(func(t *testing.T, raw []byte) {
+		frame, err := DecodeFrame(bytes.NewReader(raw))
+		if err != nil {
+			return
+		}
+		if len(frame.Payload) > int(^uint16(0)) {
+			t.Fatalf("payload length %d exceeds the wire limit", len(frame.Payload))
+		}
+		_, _ = EncodeFrame(frame)
+	})
+}
+
+// FuzzDecodeFramePooled covers the pooled path the carrier read loop uses;
+// a decoded payload must always be returned to the pool exactly once.
+func FuzzDecodeFramePooled(f *testing.F) {
+	for _, raw := range referenceFrames {
+		seed, err := hex.DecodeString(raw)
+		if err != nil {
+			f.Fatalf("decode seed: %v", err)
+		}
+		f.Add(seed)
+	}
+	f.Fuzz(func(t *testing.T, raw []byte) {
+		decoded, err := decodeFramePooled(bytes.NewReader(raw), make([]byte, MaxMetadataSize))
+		if err != nil {
+			return
+		}
+		decoded.releasePayload()
+	})
+}
