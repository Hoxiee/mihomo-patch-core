diff --git a/transport/muxcool/drain_test.go b/transport/muxcool/drain_test.go
new file mode 100644
index 0000000..51f3c2d
--- /dev/null
+++ b/transport/muxcool/drain_test.go
@@ -0,0 +1,32 @@
+package muxcool
+
+import (
+	"context"
+	"sync"
+	"testing"
+	"time"
+)
+
+// The first allocation reaches maxLifetime, so the carrier drains before it
+// is closed; the close must not wait on itself through removeSession.
+func TestDrainingCarrierCloseDoesNotDeadlock(t *testing.T) {
+	carrier := newTestCarrier()
+	closed := make(chan struct{})
+	var once sync.Once
+	worker := newCarrierWorker(carrier, 8, 1, func(*carrierWorker) {
+		once.Do(func() { close(closed) })
+	})
+	conn, err := worker.openSession(context.Background(), "drain.example", 80, time.Hour)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = conn.Close() })
+
+	go worker.close(nil)
+
+	select {
+	case <-closed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("closing a draining carrier deadlocked")
+	}
+}
