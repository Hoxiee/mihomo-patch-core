diff --git a/transport/muxcool/stats_test.go b/transport/muxcool/stats_test.go
new file mode 100644
index 0000000..83612d2
--- /dev/null
+++ b/transport/muxcool/stats_test.go
@@ -0,0 +1,95 @@
+package muxcool
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"net"
+	"testing"
+)
+
+var errTestDial = errors.New("test carrier dial failed")
+
+func TestPoolStatsReportsSessionsQueuesAndDrops(t *testing.T) {
+	tcpDialer := &fakeCarrierDialer{}
+	tcpPool := NewPool(tcpDialer.dial, testPoolOptions())
+	t.Cleanup(func() { _ = tcpPool.Close() })
+	stream, err := tcpPool.DialContext(context.Background(), "stats.example", 443)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = stream.Close() })
+
+	udpDialer := &fakeCarrierDialer{}
+	udpPool := NewPool(udpDialer.dial, testPoolOptions())
+	t.Cleanup(func() { _ = udpPool.Close() })
+	packetConn, err := udpPool.ListenPacketContext(context.Background(), "stats.example", 53, [8]byte{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = packetConn.Close() })
+
+	payload := bytes.Repeat([]byte{0x33}, MaxPayloadSize)
+	tcpCarrier := tcpDialer.carriers[0]
+	tcpCarrier.inject(t, Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: payload})
+
+	udpCarrier := udpDialer.carriers[0]
+	for i := 0; i < packetDownlinkFrames*2; i++ {
+		udpCarrier.inject(t, Frame{
+			SessionID: 1, Status: StatusKeep, Option: OptionData, Network: NetworkUDP,
+			Destination: "1.1.1.1", Port: 53, Payload: []byte("datagram"),
+		})
+	}
+	waitFor(t, func() bool { return udpPool.Stats().DroppedDatagrams > 0 })
+
+	tcpStats := tcpPool.Stats()
+	if tcpStats.Carriers != 1 || tcpStats.TCPSessions != 1 || tcpStats.UDPSessions != 0 {
+		t.Fatalf("TCP stats = %+v, want one carrier with one TCP session", tcpStats)
+	}
+	udpStats := udpPool.Stats()
+	if udpStats.Carriers != 1 || udpStats.UDPSessions != 1 || udpStats.TCPSessions != 0 {
+		t.Fatalf("UDP stats = %+v, want one carrier with one UDP session", udpStats)
+	}
+	if udpStats.QueuedItems == 0 || udpStats.QueuedBytes == 0 {
+		t.Fatalf("UDP stats = %+v, want queued datagrams", udpStats)
+	}
+
+	// The TCP consumer never reads; the queue overflows and only that
+	// session resets.
+	for i := 0; i < sessionDownlinkFrames*2; i++ {
+		tcpCarrier.inject(t, Frame{SessionID: 1, Status: StatusKeep, Option: OptionData, Payload: payload})
+	}
+	waitFor(t, func() bool { return tcpPool.Stats().SessionOverflows == 1 })
+	waitFor(t, func() bool { return tcpPool.Stats().TCPSessions == 0 })
+
+	_ = stream.Close()
+	_ = packetConn.Close()
+	waitFor(t, func() bool { return tcpPool.Stats().IdleCarriers == 1 })
+	waitFor(t, func() bool { return udpPool.Stats().IdleCarriers == 1 })
+
+	_ = tcpPool.Close()
+	_ = udpPool.Close()
+	if closes := tcpPool.Stats().CarrierCloses["pool"]; closes != 1 {
+		t.Fatalf("TCP pool close count = %d, want 1", closes)
+	}
+	if closes := udpPool.Stats().CarrierCloses["pool"]; closes != 1 {
+		t.Fatalf("UDP pool close count = %d, want 1", closes)
+	}
+}
+
+func TestPoolStatsCountsDialFailures(t *testing.T) {
+	pool := NewPool(func(context.Context) (net.Conn, error) {
+		return nil, errTestDial
+	}, testPoolOptions())
+	t.Cleanup(func() { _ = pool.Close() })
+
+	if _, err := pool.DialContext(context.Background(), "fail.example", 80); err == nil {
+		t.Fatal("dial succeeded")
+	}
+	if got := pool.Stats().DialFailures; got != 1 {
+		t.Fatalf("dial failures = %d, want 1", got)
+	}
+	if got := pool.Stats().PendingOpens; got != 0 {
+		t.Fatalf("pending opens = %d, want 0", got)
+	}
+}
