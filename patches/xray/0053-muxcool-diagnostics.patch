+type workerStats struct {
+	carriers      int
+	idle          int
+	draining      int
+	tcpSessions   int
+	udpSessions   int
+	queuedItems   int
+	queuedBytes   int
+	writeTimeouts uint64
+}
+
+func (w *carrierWorker) stats() workerStats {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	stats := workerStats{
+		carriers:      1,
+		writeTimeouts: w.writeTimeouts.Load(),
+	}
+	if w.draining {
+		stats.draining = 1
+	}
+	if len(w.sessions) == 0 {
+		stats.idle = 1
+	}
+	for _, logicalSession := range w.sessions {
+		switch logicalSession.(type) {
+		case *packetSession:
+			stats.udpSessions++
+		default:
+			stats.tcpSessions++
+		}
+		session := logicalSession.stats()
+		stats.queuedItems += session.queuedItems
+		stats.queuedBytes += session.queuedBytes
+	}
+	return stats
+}
