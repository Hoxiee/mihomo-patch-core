+// MuxCoolStats is a diagnostic snapshot of a mux.cool outbound. Shared means
+// UDP rides the TCP pool (xudp-concurrency 0); otherwise UDP is its own pool.
+type MuxCoolStats struct {
+	TCP    muxcool.Stats
+	UDP    muxcool.Stats
+	Shared bool
+}
+
+// Stats reports carrier, session and queue state without logging or exposing
+// destinations, credentials or payload.
+func (x *MuxCool) Stats() MuxCoolStats {
+	stats := MuxCoolStats{Shared: x.xudpPool == nil && x.pool != nil}
+	if x.pool != nil {
+		stats.TCP = x.pool.Stats()
+	}
+	if x.xudpPool != nil {
+		stats.UDP = x.xudpPool.Stats()
+	}
+	return stats
+}
+
 func (x *MuxCool) ProxyInfo() C.ProxyInfo {
 	info := x.ProxyAdapter.ProxyInfo()
 	info.XUDP = x.xudpPool != nil || x.pool != nil
