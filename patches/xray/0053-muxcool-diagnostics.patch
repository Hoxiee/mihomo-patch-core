--- /dev/null
+++ b/adapter/outbound/muxcool_stats_test.go
@@ -0,0 +1,59 @@
+package outbound
+
+import (
+	"context"
+	"net/netip"
+	"testing"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+func TestMuxCoolStatsReportsPools(t *testing.T) {
+	base := newFakeMuxCoolAdapter()
+	wrapped, err := NewMuxCool(MuxCoolOption{Enabled: true}, base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = wrapped.Close() })
+	stream, err := wrapped.DialContext(context.Background(), &C.Metadata{NetWork: C.TCP, Host: "stats.example", DstPort: 443})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = stream.Close() })
+	server := <-base.carrierServers
+	t.Cleanup(func() { _ = server.Close() })
+
+	stats := wrapped.(*MuxCool).Stats()
+	if !stats.Shared {
+		t.Fatal("Shared = false with UDP riding the TCP pool")
+	}
+	if stats.TCP.Carriers != 1 || stats.TCP.TCPSessions != 1 || stats.TCP.UDPSessions != 0 {
+		t.Fatalf("TCP pool stats = %+v", stats.TCP)
+	}
+
+	udpBase := newFakeMuxCoolAdapter()
+	udpWrapped, err := NewMuxCool(MuxCoolOption{Enabled: true, TCPDisabled: true, XUDPConcurrency: 2}, udpBase)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = udpWrapped.Close() })
+	metadata := &C.Metadata{
+		NetWork: C.UDP, Host: "stats.example", DstPort: 53,
+		SrcIP: netip.MustParseAddr("192.0.2.10"), SrcPort: 4242,
+	}
+	packetConn, err := udpWrapped.ListenPacketContext(context.Background(), metadata)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = packetConn.Close() })
+	carrierServer := <-udpBase.carrierServers
+	t.Cleanup(func() { _ = carrierServer.Close() })
+
+	udpStats := udpWrapped.(*MuxCool).Stats()
+	if udpStats.Shared {
+		t.Fatal("Shared = true with a separate XUDP pool")
+	}
+	if udpStats.UDP.Carriers != 1 || udpStats.UDP.UDPSessions != 1 || udpStats.TCP.Carriers != 0 {
+		t.Fatalf("UDP pool stats = %+v", udpStats)
+	}
+}
