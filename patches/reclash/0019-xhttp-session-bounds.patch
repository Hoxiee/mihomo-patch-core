diff --git a/transport/xhttp/session_bounds_test.go b/transport/xhttp/session_bounds_test.go
new file mode 100644
index 0000000..7096a01
--- /dev/null
+++ b/transport/xhttp/session_bounds_test.go
@@ -0,0 +1,30 @@
+package xhttp
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestGetGenerateSessionIDRejectsHugeRange(t *testing.T) {
+	cfg := &Config{SessionTable: "a", SessionLength: "0-2147483647"}
+	if _, err := cfg.GetGenerateSessionID(); err == nil {
+		t.Fatal("a session-length range spanning billions of values must be rejected")
+	}
+}
+
+func TestGetGenerateSessionIDRejectsHugeTable(t *testing.T) {
+	cfg := &Config{
+		SessionTable:  strings.Repeat("a", maxSessionTable+1),
+		SessionLength: "16-32",
+	}
+	if _, err := cfg.GetGenerateSessionID(); err == nil {
+		t.Fatal("a session-table larger than the bound must be rejected")
+	}
+}
+
+func TestGetGenerateSessionIDKeepsNormalSettings(t *testing.T) {
+	cfg := &Config{SessionTable: "abcdefghijklmnopqrstuvwxyz", SessionLength: "16-32"}
+	if _, err := cfg.GetGenerateSessionID(); err != nil {
+		t.Fatalf("normal session settings must load: %v", err)
+	}
+}
