+const (
+	maxSessionLength = 4096
+	maxSessionTable  = 4096
+	sessionRoomFloor = 2 << 30
+)
+
 func roomSize(tableSize int, min, max int) *big.Int {
 	base := big.NewInt(int64(tableSize))
 	sum := new(big.Int)
 	term := new(big.Int)
+	floor := big.NewInt(sessionRoomFloor)
 	for k := min; k <= max; k++ {
 		term.Exp(base, big.NewInt(int64(k)), nil)
 		sum.Add(sum, term)
+		if sum.Cmp(floor) >= 0 {
+			return sum
+		}
 	}
 	return sum
 }
