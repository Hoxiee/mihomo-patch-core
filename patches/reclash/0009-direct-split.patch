mihomo-patch-core: reclash/0009-direct-split
Source: Hoxiee/mihomo 5635c762 (GPL-3.0), split from the ReClash core fork.

diff --git a/tunnel/patch.go b/tunnel/patch.go
index 4d6c9b0..33a9186 100644
--- a/tunnel/patch.go
+++ b/tunnel/patch.go
@@ -139,3 +139,21 @@ func specialProxy(metadata *C.Metadata) (C.Proxy, C.Rule, error) {
 	}
 	return nil, nil, fmt.Errorf("proxy %s not found", metadata.SpecialProxy)
 }
+
+// DirectSplitHook lets the host send a connection an explicit DIRECT rule
+// matched through another proxy, by name; empty keeps it direct. ReClash uses
+// it where direct access to home sites is lost. It runs on every such match,
+// under the config lock, and must not block.
+var DirectSplitHook func(metadata *C.Metadata) string
+
+// The final MATCH rule is not split: "proxy everything" is never implied.
+func directSplit(metadata *C.Metadata, adapter C.Proxy, rule C.Rule) C.Proxy {
+	if DirectSplitHook == nil || adapter.Type() != C.Direct || rule.RuleType() == C.MATCH {
+		return nil
+	}
+	target, ok := proxies[DirectSplitHook(metadata)]
+	if !ok || metadata.NetWork == C.UDP && !target.SupportUDP() {
+		return nil
+	}
+	return target
+}
diff --git a/tunnel/tunnel.go b/tunnel/tunnel.go
index dd6d44b..0eeb082 100644
--- a/tunnel/tunnel.go
+++ b/tunnel/tunnel.go
@@ -715,6 +715,9 @@ func match(metadata *C.Metadata, helper C.RuleMatchHelper) (C.Proxy, C.Rule, err
 					continue
 				}
 
+				if split := directSplit(metadata, adapter, rule); split != nil {
+					return split, rule, nil
+				}
 				return adapter, rule, nil
 			}
 		}
