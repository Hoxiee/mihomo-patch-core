+
+func TestPingCycleDueHonorsScreenAndSuppression(t *testing.T) {
+	hc := &HealthCheck{interval: time.Minute, owner: "test-provider"}
+	t.Cleanup(func() {
+		SetScreenOff(false)
+		SetAutoHealthCheckSuppressed(nil)
+	})
+
+	SetScreenOff(true)
+	if hc.pingCycleDue(time.Minute) {
+		t.Fatal("screen-off must stop ping-config cycles")
+	}
+
+	SetScreenOff(false)
+	SetAutoHealthCheckSuppressed([]string{hc.owner})
+	if hc.pingCycleDue(time.Minute) {
+		t.Fatal("a suppressed provider must stop ping-config cycles")
+	}
+
+	SetAutoHealthCheckSuppressed(nil)
+	if !hc.pingCycleDue(time.Minute) {
+		t.Fatal("an active provider must run ping-config cycles")
+	}
+}
