+// TrustTunnel has its own bool `quic` option; the udp-443 alias must not make
+// the shared BasicOption decoder reject that existing proxy type.
+func TestParseProxyTrustTunnelQuicBool(t *testing.T) {
+	if _, err := ParseProxy(map[string]any{
+		"name": "tt", "type": "trusttunnel", "server": "example.com", "port": 443,
+		"username": "u", "password": "p", "quic": true,
+	}); err != nil {
+		t.Fatalf("TrustTunnel quic bool must decode: %v", err)
+	}
+}
