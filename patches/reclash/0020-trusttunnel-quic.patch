+// quicAlias reads the string form of the udp-443 alias. TrustTunnel owns the
+// same key as a bool, and must not receive a string through BasicOption.
+func quicAlias(mapping map[string]any) string {
+	if mapping["type"] == "trusttunnel" {
+		return ""
+	}
+	value, _ := mapping["quic"].(string)
+	return value
+}
