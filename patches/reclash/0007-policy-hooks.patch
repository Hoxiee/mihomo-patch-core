@@ -257,6 +257,9 @@ func Mode() TunnelMode {
 
 // SetMode change the mode of tunnel
 func SetMode(m TunnelMode) {
+	if mode != m && ModeChangeHook != nil {
+		ModeChangeHook(m)
+	}
 	mode = m
 }
 
@@ -318,6 +321,12 @@ func preHandleMetadata(metadata *C.Metadata) error {
 }
 
 func resolveMetadata(metadata *C.Metadata) (proxy C.Proxy, rule C.Rule, err error) {
+	metadata.PolicyGlobal = metadata.PolicyGlobal || mode == Global
+	if MetadataPolicyHook != nil {
+		if err := MetadataPolicyHook(metadata); err != nil {
+			return nil, nil, err
+		}
+	}
 	if metadata.SpecialProxy != "" {
 		var exist bool
 		proxy, exist = proxies[metadata.SpecialProxy]
