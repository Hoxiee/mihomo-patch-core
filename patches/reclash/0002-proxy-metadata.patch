+package adapter
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestProxyDiversityFingerprintSeparatesTransportAndHidesSNI(t *testing.T) {
+	base := map[string]any{
+		"network":    "ws",
+		"tls":        true,
+		"servername": "secret.example",
+	}
+	first := proxyDiversityFingerprint("vless", base)
+	second := proxyDiversityFingerprint("vless", map[string]any{
+		"network":    "grpc",
+		"tls":        true,
+		"servername": "secret.example",
+	})
+
+	if first == second {
+		t.Fatal("different transports produced one diversity fingerprint")
+	}
+	if strings.Contains(first, "secret.example") {
+		t.Fatal("diversity fingerprint exposed the raw SNI")
+	}
+	if first != proxyDiversityFingerprint("vless", base) {
+		t.Fatal("diversity fingerprint is not deterministic")
+	}
+}
+
+func TestProxyDiversityFingerprintTracksRealityAndObfs(t *testing.T) {
+	plain := proxyDiversityFingerprint("vless", map[string]any{})
+	disguised := proxyDiversityFingerprint("vless", map[string]any{
+		"reality-opts": map[string]any{"server-name": "example.com"},
+		"obfs":         "salamander",
+	})
+
+	if plain == disguised {
+		t.Fatal("reality and obfs did not affect diversity")
+	}
+}
diff --git a/adapter/route_identity.go b/adapter/route_identity.go
new file mode 100644
index 0000000..670fde1
--- /dev/null
+++ b/adapter/route_identity.go
@@ -0,0 +1,57 @@
+package adapter
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+)
+
+func (p *Proxy) RouteFingerprint() string    { return p.routeFingerprint }
+func (p *Proxy) EndpointFingerprint() string { return p.endpointFingerprint }
+func (p *Proxy) RouteDependency() string     { return p.routeDependency }
+
+func RouteFingerprintOf(mapping map[string]any) string { return proxyRouteFingerprint(mapping) }
+
+func proxyRouteFingerprint(mapping map[string]any) string {
+	route := make(map[string]any, len(mapping))
+	for key, value := range mapping {
+		if key != "name" && key != "reclash-id" {
+			route[key] = value
+		}
+	}
+	data, err := json.Marshal(route)
+	if err != nil {
+		return ""
+	}
+	sum := sha256.Sum256(data)
+	return "route-v1:" + hex.EncodeToString(sum[:])
+}
+
+// Providers rotate credentials (uuid, short-id, password) without moving the
+// server, so the endpoint alone lets the routing engine keep a node's history
+// across such a refresh.
+func proxyEndpointFingerprint(mapping map[string]any) string {
+	endpoint := map[string]any{
+		"type":   mapping["type"],
+		"server": mapping["server"],
+		"port":   mapping["port"],
+		"sni":    firstString(mapping, "servername", "sni", "peer"),
+	}
+	if host := firstString(mapping, "host"); host != "" {
+		endpoint["host"] = host
+	}
+	for _, key := range []string{"ws-opts", "http-opts", "h2-opts", "grpc-opts", "xhttp-opts"} {
+		if opts, ok := mapping[key].(map[string]any); ok {
+			endpoint[key+".path"] = firstString(opts, "path", "grpc-service-name")
+			if headers, ok := opts["headers"].(map[string]any); ok {
+				endpoint[key+".host"] = firstString(headers, "Host", "host")
+			}
+		}
+	}
+	data, err := json.Marshal(endpoint)
+	if err != nil {
+		return ""
+	}
+	sum := sha256.Sum256(data)
+	return "endpoint-v1:" + hex.EncodeToString(sum[:])
+}
diff --git a/adapter/route_identity_test.go b/adapter/route_identity_test.go
