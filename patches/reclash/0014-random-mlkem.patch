+
+// buildRandomizedUClient removes the P-256 key share from a randomized hello
+// before the caller builds the handshake.
+func buildRandomizedUClient(c net.Conn, config *utls.Config, fingerprint UClientHelloID) *UConn {
+	uConn := utls.UClient(c, config, fingerprint)
+	if isRandomized(fingerprint) {
+		if err := uConn.BuildHandshakeState(); err == nil {
+			_ = DropRandomizedP256KeyShare(uConn)
+		}
+	}
+	return uConn
 }
diff --git a/component/tls/randomized_test.go b/component/tls/randomized_test.go
