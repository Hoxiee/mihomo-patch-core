diff --git a/adapter/provider/healthcheck_screen_test.go b/adapter/provider/healthcheck_screen_test.go
new file mode 100644
index 0000000..23e8483
--- /dev/null
+++ b/adapter/provider/healthcheck_screen_test.go
@@ -0,0 +1,55 @@
+package provider
+
+import (
+	"testing"
+	"time"
+)
+
+func TestHCTickDecision(t *testing.T) {
+	const interval = 5 * time.Minute
+	cases := []struct {
+		name       string
+		suppressed bool
+		screenOff  bool
+		sinceTouch time.Duration
+		lazy       bool
+		want       hcTickAction
+	}{
+		{"routing engine as sole prover defers the auto check", true, false, time.Second, false, hcDefer},
+		{"suppressed wins even with the screen on", true, false, time.Second, true, hcDefer},
+		{"screen off defers even when recently touched", false, true, time.Second, false, hcDefer},
+		{"screen off defers a lazy idle group", false, true, 10 * time.Minute, true, hcDefer},
+		{"screen on, recently touched, runs", false, false, time.Second, false, hcRun},
+		{"screen on, recently touched, runs even if lazy", false, false, time.Second, true, hcRun},
+		{"screen on, idle and lazy, skips", false, false, 10 * time.Minute, true, hcSkip},
+		{"screen on, idle and eager, runs", false, false, 10 * time.Minute, false, hcRun},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			if got := hcTickDecision(c.suppressed, c.screenOff, c.sinceTouch, interval, c.lazy); got != c.want {
+				t.Fatalf("got %d, want %d", got, c.want)
+			}
+		})
+	}
+}
+
+func TestAutoHealthCheckSuppressionIsPerProvider(t *testing.T) {
+	t.Cleanup(func() { SetAutoHealthCheckSuppressed(nil) })
+	SetAutoHealthCheckSuppressed([]string{"smart"})
+	if !autoHealthCheckSuppressed("smart") || autoHealthCheckSuppressed("other") {
+		t.Fatal("suppression leaked across providers")
+	}
+	wake := screenWake()
+	SetAutoHealthCheckSuppressed([]string{"smart", "more"})
+	select {
+	case <-wake:
+		t.Fatal("adding a provider flushed deferred checks")
+	default:
+	}
+	SetAutoHealthCheckSuppressed([]string{"more"})
+	select {
+	case <-wake:
+	default:
+		t.Fatal("a released provider kept its deferred check waiting")
+	}
+}
diff --git a/adapter/provider/patch.go b/adapter/provider/patch.go
index 1f3306a..bd680b2 100644
--- a/adapter/provider/patch.go
+++ b/adapter/provider/patch.go
@@ -1,5 +1,76 @@
 package provider
 
+import "sync"
+
 func (pp *proxySetProvider) GetSubscriptionInfo() *SubscriptionInfo {
 	return pp.subscriptionInfo
 }
+
+var (
+	screenMu     sync.Mutex
+	screenIsOff  bool
+	hcSuppressed map[string]struct{}
+	screenWakeCh = make(chan struct{})
+)
+
+// Periodic probes are the tunnel's main idle-time radio wake-up, and a group
+// nothing routed through while the screen was off has no reason to be probed.
+// The tick is deferred rather than dropped: it runs when the screen comes back,
+// so the delays a user sees are never the ones measured in their pocket.
+func SetScreenOff(off bool) {
+	screenMu.Lock()
+	defer screenMu.Unlock()
+	if screenIsOff == off {
+		return
+	}
+	screenIsOff = off
+	if off {
+		return
+	}
+	close(screenWakeCh)
+	screenWakeCh = make(chan struct{})
+}
+
+func screenOff() bool {
+	screenMu.Lock()
+	defer screenMu.Unlock()
+	return screenIsOff
+}
+
+// SetAutoHealthCheckSuppressed pauses the auto health check of the named
+// providers while the routing engine is their single prover, so their nodes are
+// not probed twice; other providers keep checking and the engine harvests their
+// results. A provider leaving the set flushes its deferred tick at once.
+func SetAutoHealthCheckSuppressed(providers []string) {
+	next := make(map[string]struct{}, len(providers))
+	for _, name := range providers {
+		next[name] = struct{}{}
+	}
+	screenMu.Lock()
+	defer screenMu.Unlock()
+	released := false
+	for name := range hcSuppressed {
+		if _, kept := next[name]; !kept {
+			released = true
+		}
+	}
+	hcSuppressed = next
+	if !released {
+		return
+	}
+	close(screenWakeCh)
+	screenWakeCh = make(chan struct{})
+}
+
+func autoHealthCheckSuppressed(provider string) bool {
+	screenMu.Lock()
+	defer screenMu.Unlock()
+	_, suppressed := hcSuppressed[provider]
+	return suppressed
+}
+
+func screenWake() <-chan struct{} {
+	screenMu.Lock()
+	defer screenMu.Unlock()
+	return screenWakeCh
+}
