@@ -0,0 +1,61 @@
+package pingconfig
+
+import (
+	"math/rand"
+	"sort"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+)
+
+// Slot is one check of a cycle: node Node at Offset from the cycle start.
+type Slot struct {
+	Node   int
+	Offset time.Duration
+}
+
+// Plan lays out a cycle of nodes checks: each node Sampling times, the
+// k-th at a random moment of the k-th interval, so a node's checks are
+// spread over the cycle and different nodes are not checked at once.
+// The slots come in time order.
+func Plan(nodes int, p *Profile, rnd *rand.Rand) []Slot {
+	slots := make([]Slot, 0, nodes*p.Sampling)
+	for k := 0; k < p.Sampling; k++ {
+		base := time.Duration(k) * p.Interval
+		for i := 0; i < nodes; i++ {
+			slots = append(slots, Slot{Node: i, Offset: base + time.Duration(rnd.Int63n(int64(p.Interval)))})
+		}
+	}
+	sort.SliceStable(slots, func(a, b int) bool { return slots[a].Offset < slots[b].Offset })
+	return slots
+}
+
+// WindowStats judges a node by the results within window before now, as
+// Xray does with sampling: alive if any of them succeeded, its delay the
+// mean of those that did. With no result in the window the last one
+// decides, so a pause in checks (lazy, power save) does not kill a node.
+func WindowStats(history []C.DelayHistory, now time.Time, window time.Duration) (alive bool, delay uint16) {
+	if len(history) == 0 {
+		return false, 0
+	}
+	var sum, n int
+	inWindow := false
+	for _, h := range history {
+		if now.Sub(h.Time) > window {
+			continue
+		}
+		inWindow = true
+		if h.Delay > 0 {
+			sum += int(h.Delay)
+			n++
+		}
+	}
+	if !inWindow {
+		last := history[len(history)-1]
+		return last.Delay > 0, last.Delay
+	}
+	if n == 0 {
+		return false, 0
+	}
+	return true, uint16(sum / n)
+}
diff --git a/component/pingconfig/profile.go b/component/pingconfig/profile.go
new file mode 100644
index 0000000..9c4d5c2
--- /dev/null
+++ b/component/pingconfig/profile.go
@@ -0,0 +1,285 @@
+// Package pingconfig holds the ping-config of proxy groups: how the nodes
+// behind a group url are checked, in the spirit of Xray's
+// burstObservatory.pingConfig.
+//
+// The delay of a node still comes from the group url, measured as before
+// (HEAD, unified-delay). A profile adds a check of its destination after
+// it: the node is alive only when that request answers in time, so a node
+// that sends headers and then stalls on the body counts as dead. It also
+// spreads the checks over a cycle at random moments and, with sampling,
+// judges a node by a window of results instead of the last one.
+//
+// A profile belongs to the url it is keyed by: every check of that url,
+// whichever group, provider or API call asks for it, runs by the profile.
+// The url stays the key of the delay history, so the API and the apps
+// see the same testUrl as without a profile.
+package pingconfig
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/metacubex/mihomo/common/structure"
+)
+
+const (
+	MethodHEAD = "HEAD"
+	MethodGET  = "GET"
+
+	// MinInterval is the shortest interval a config may set.
+	MinInterval = 10 * time.Second
+	// MaxSampling bounds sampling: the window keeps 2×sampling results.
+	MaxSampling = 32
+	// MaxBody is how much of a GET body a check reads.
+	MaxBody = 4 << 20
+
+	defaultInterval = 300 * time.Second
+	defaultTimeout  = 5000 * time.Millisecond
+)
+
+// Profile is the ping-config of one group url.
+type Profile struct {
+	// URL is the group url the profile is keyed by; its delay is the one
+	// a node reports.
+	URL string
+	// Destination is asked after URL; it defaults to URL.
+	Destination string
+	// Method is MethodHEAD or MethodGET, for Destination.
+	Method string
+	// Interval is the base interval: a cycle is Interval × Sampling.
+	Interval time.Duration
+	// Sampling is how many checks of each node a cycle makes.
+	Sampling int
+	// Timeout bounds the request to Destination.
+	Timeout time.Duration
+	// Connectivity, when set, is asked DIRECT after a failed check: with
+	// no answer the device is offline and the failure is not recorded.
+	Connectivity string
+	// Group is the group that set the profile, for logs.
+	Group string
+
+	bodyBytes atomic.Int64
+	warned    atomic.Bool
+}
+
+// Defaults are what a ping-config takes from its group.
+type Defaults struct {
+	Group    string
+	URL      string // the resolved group url
+	Interval int    // group interval, seconds; 0 if unset
+	Timeout  int    // group timeout, milliseconds; 0 if unset
+}
+
+type rawProfile struct {
+	Destination  string `ping:"destination,omitempty"`
+	Interval     any    `ping:"interval,omitempty"`
+	Sampling     int    `ping:"sampling,omitempty"`
+	Timeout      any    `ping:"timeout,omitempty"`
+	HTTPMethod   string `ping:"http-method,omitempty"`
+	Connectivity string `ping:"connectivity,omitempty"`
+}
+
+// Parse reads a group's ping-config block. Fields left out come from the
+// group: destination from its url, interval and timeout from its own.
+// warn receives notes on values that were adjusted.
+func Parse(raw map[string]any, d Defaults, warn func(format string, args ...any)) (*Profile, error) {
+	var r rawProfile
+	decoder := structure.NewDecoder(structure.Option{TagName: "ping", WeaklyTypedInput: true})
+	if err := decoder.Decode(raw, &r); err != nil {
+		return nil, fmt.Errorf("ping-config: %w", err)
+	}
+	if d.URL == "" {
+		return nil, fmt.Errorf("ping-config: the group has no url")
+	}
+
+	p := &Profile{
+		URL:          d.URL,
+		Destination:  strings.TrimSpace(r.Destination),
+		Method:       strings.ToUpper(strings.TrimSpace(r.HTTPMethod)),
+		Sampling:     r.Sampling,
+		Connectivity: strings.TrimSpace(r.Connectivity),
+		Group:        d.Group,
+	}
+	if p.Destination == "" {
+		p.Destination = d.URL
+	}
+	if err := checkURL("destination", p.Destination); err != nil {
+		return nil, err
+	}
+	if p.Connectivity != "" {
+		if err := checkURL("connectivity", p.Connectivity); err != nil {
+			return nil, err
+		}
+	}
+	switch p.Method {
+	case "":
+		p.Method = MethodHEAD
+	case MethodHEAD, MethodGET:
+	default:
+		return nil, fmt.Errorf("ping-config: http-method %q is not HEAD or GET", r.HTTPMethod)
+	}
+	switch {
+	case p.Sampling == 0:
+		p.Sampling = 1
+	case p.Sampling < 0 || p.Sampling > MaxSampling:
+		return nil, fmt.Errorf("ping-config: sampling %d is not between 1 and %d", p.Sampling, MaxSampling)
+	}
+
+	var err error
+	if p.Interval, err = parseDuration("interval", r.Interval, time.Second); err != nil {
+		return nil, err
+	}
+	if p.Interval == 0 {
+		p.Interval = time.Duration(d.Interval) * time.Second
+	}
+	if p.Interval == 0 {
+		p.Interval = defaultInterval
+	}
+	if p.Interval < MinInterval {
+		if warn != nil {
+			warn("ping-config of %s: interval %s is below %s, using %s", d.Group, p.Interval, MinInterval, MinInterval)
+		}
+		p.Interval = MinInterval
+	}
+
+	if p.Timeout, err = parseDuration("timeout", r.Timeout, time.Millisecond); err != nil {
+		return nil, err
+	}
+	if p.Timeout == 0 {
+		p.Timeout = time.Duration(d.Timeout) * time.Millisecond
+	}
+	if p.Timeout == 0 {
+		p.Timeout = defaultTimeout
+	}
+	return p, nil
+}
+
+func checkURL(field, raw string) error {
+	u, err := url.Parse(raw)
+	if err != nil || (u.Scheme != "http" && u.Scheme != "https") || u.Host == "" {
+		return fmt.Errorf("ping-config: %s %q is not an http or https address", field, raw)
+	}
+	return nil
+}
+
+// parseDuration takes "15s", "1m", "500ms", or a bare number in unit.
+func parseDuration(field string, v any, unit time.Duration) (time.Duration, error) {
+	var n float64
+	switch v := v.(type) {
+	case nil:
+		return 0, nil
+	case int:
+		n = float64(v)
+	case int64:
+		n = float64(v)
+	case uint64:
+		n = float64(v)
+	case float64:
+		n = v
+	case string:
+		s := strings.TrimSpace(v)
+		if s == "" {
+			return 0, nil
+		}
+		f, err := strconv.ParseFloat(s, 64)
+		if err != nil {
+			d, err := time.ParseDuration(s)
+			if err != nil || d < 0 {
+				return 0, fmt.Errorf("ping-config: %s %q is not a duration", field, s)
+			}
+			return d, nil
+		}
+		n = f
+	default:
+		return 0, fmt.Errorf("ping-config: %s %v is not a duration", field, v)
+	}
+	if n < 0 {
+		return 0, fmt.Errorf("ping-config: %s %v is negative", field, v)
+	}
+	return time.Duration(n * float64(unit)), nil
+}
+
+// Cycle is how long one round of checks takes: Interval × Sampling.
+func (p *Profile) Cycle() time.Duration {
+	return p.Interval * time.Duration(p.Sampling)
+}
+
+// Window is how far back sampled results count: two cycles, as in Xray.
+func (p *Profile) Window() time.Duration {
+	return 2 * p.Cycle()
+}
+
+// AsksDestination says whether a check makes a request to Destination
+// after the url's: not when it would repeat the url's own HEAD.
+func (p *Profile) AsksDestination() bool {
+	return p.Method != MethodHEAD || p.Destination != p.URL
+}
+
+// CheckTimeout is how long a whole check may take, given the time the
+// url's own request has.
+func (p *Profile) CheckTimeout(urlTimeout time.Duration) time.Duration {
+	if !p.AsksDestination() {
+		return urlTimeout
+	}
+	return urlTimeout + p.Timeout
+}
+
+// HistoryLimit is how many results of the url a node keeps: enough for
+// the window.
+func (p *Profile) HistoryLimit(base int) int {
+	if n := 2*p.Sampling + 1; n > base {
+		return n
+	}
+	return base
+}
+
+// Same says whether two profiles check the same way.
+func (p *Profile) Same(o *Profile) bool {
+	return p.URL == o.URL && p.Destination == o.Destination && p.Method == o.Method &&
+		p.Interval == o.Interval && p.Sampling == o.Sampling && p.Timeout == o.Timeout &&
+		p.Connectivity == o.Connectivity
+}
+
+// NoteBody records the size of a GET body a check read.
+func (p *Profile) NoteBody(n int64) {
+	for {
+		old := p.bodyBytes.Load()
+		if n <= old || p.bodyBytes.CompareAndSwap(old, n) {
+			return
+		}
+	}
+}
+
+// DailyTraffic estimates the bytes a day the destination checks of nodes
+// nodes take, from the largest body read so far.
+func (p *Profile) DailyTraffic(nodes int) int64 {
+	if p.Method != MethodGET || p.Interval <= 0 {
+		return 0
+	}
+	perDay := int64(24 * time.Hour / p.Interval)
+	return p.bodyBytes.Load() * int64(nodes) * perDay
+}
+
+// WarnOnce reports whether this is the first call: for a one-time log.
+func (p *Profile) WarnOnce() bool {
+	return p.warned.CompareAndSwap(false, true)
+}
+
+func (p *Profile) MarshalJSON() ([]byte, error) {
+	m := map[string]any{
+		"destination": p.Destination,
+		"interval":    int64(p.Interval / time.Second),
+		"sampling":    p.Sampling,
+		"timeout":     int64(p.Timeout / time.Millisecond),
+		"httpMethod":  p.Method,
+	}
+	if p.Connectivity != "" {
+		m["connectivity"] = p.Connectivity
+	}
+	return json.Marshal(m)
+}
diff --git a/component/pingconfig/profile_test.go b/component/pingconfig/profile_test.go
new file mode 100644
index 0000000..3a30d6d
--- /dev/null
+++ b/component/pingconfig/profile_test.go
@@ -0,0 +1,297 @@
+package pingconfig
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/rand"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	C "github.com/metacubex/mihomo/constant"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+const groupURL = "https://www.gstatic.com/generate_204"
+
+func defaults() Defaults {
+	return Defaults{Group: "auto", URL: groupURL, Interval: 120, Timeout: 4000}
+}
+
+// Every field left out comes from the group, or from the defaults when the
+// group has none either.
+func TestParseInheritsFromTheGroup(t *testing.T) {
+	p, err := Parse(map[string]any{}, defaults(), nil)
+	require.NoError(t, err)
+	assert.Equal(t, groupURL, p.URL)
+	assert.Equal(t, groupURL, p.Destination)
+	assert.Equal(t, MethodHEAD, p.Method)
+	assert.Equal(t, 1, p.Sampling)
+	assert.Equal(t, 120*time.Second, p.Interval)
+	assert.Equal(t, 4*time.Second, p.Timeout)
+	assert.Equal(t, "", p.Connectivity)
+	assert.Equal(t, "auto", p.Group)
+
+	p, err = Parse(map[string]any{}, Defaults{Group: "auto", URL: groupURL}, nil)
+	require.NoError(t, err)
+	assert.Equal(t, 300*time.Second, p.Interval)
+	assert.Equal(t, 5*time.Second, p.Timeout)
+}
+
+func TestParseTakesTheBlock(t *testing.T) {
+	p, err := Parse(map[string]any{
+		"destination":  "https://speed.cloudflare.com/__down?bytes=51200",
+		"interval":     "15s",
+		"sampling":     3,
+		"timeout":      "3s",
+		"http-method":  "get",
+		"connectivity": "http://connectivitycheck.gstatic.com/generate_204",
+	}, defaults(), nil)
+	require.NoError(t, err)
+	assert.Equal(t, "https://speed.cloudflare.com/__down?bytes=51200", p.Destination)
+	assert.Equal(t, MethodGET, p.Method)
+	assert.Equal(t, 3, p.Sampling)
+	assert.Equal(t, 15*time.Second, p.Interval)
+	assert.Equal(t, 3*time.Second, p.Timeout)
+	assert.Equal(t, "http://connectivitycheck.gstatic.com/generate_204", p.Connectivity)
+	assert.Equal(t, 45*time.Second, p.Cycle())
+	assert.Equal(t, 90*time.Second, p.Window())
+}
+
+// interval counts seconds and timeout milliseconds when bare; both take Go
+// durations as strings.
+func TestParseDurations(t *testing.T) {
+	cases := []struct {
+		interval, timeout any
+		wantI, wantT      time.Duration
+	}{
+		{15, 3000, 15 * time.Second, 3 * time.Second},
+		{"20", "2500", 20 * time.Second, 2500 * time.Millisecond},
+		{"1m", "500ms", time.Minute, 500 * time.Millisecond},
+		{30.0, 1500.0, 30 * time.Second, 1500 * time.Millisecond},
+		{uint64(60), int64(800), time.Minute, 800 * time.Millisecond},
+		{"", "", 120 * time.Second, 4 * time.Second},
+	}
+	for _, c := range cases {
+		p, err := Parse(map[string]any{"interval": c.interval, "timeout": c.timeout}, defaults(), nil)
+		require.NoError(t, err, "%v %v", c.interval, c.timeout)
+		assert.Equal(t, c.wantI, p.Interval, "%v", c.interval)
+		assert.Equal(t, c.wantT, p.Timeout, "%v", c.timeout)
+	}
+}
+
+func TestParseRaisesAShortInterval(t *testing.T) {
+	var warned int
+	p, err := Parse(map[string]any{"interval": "2s"}, defaults(), func(string, ...any) { warned++ })
+	require.NoError(t, err)
+	assert.Equal(t, MinInterval, p.Interval)
+	assert.Equal(t, 1, warned)
+}
+
+func TestParseRejectsBadValues(t *testing.T) {
+	for _, raw := range []map[string]any{
+		{"destination": "ftp://example.com/file"},
+		{"destination": "example.com/file"},
+		{"destination": "https://"},
+		{"connectivity": "udp://example.com"},
+		{"http-method": "POST"},
+		{"sampling": -1},
+		{"sampling": MaxSampling + 1},
+		{"interval": "soon"},
+		{"interval": "-5s"},
+		{"timeout": -1},
+		{"timeout": []any{1}},
+		{"sampling": "many"},
+	} {
+		_, err := Parse(raw, defaults(), nil)
+		assert.Error(t, err, "%v", raw)
+	}
+	_, err := Parse(map[string]any{}, Defaults{Group: "auto"}, nil)
+	assert.Error(t, err, "a group without url")
+}
+
+func TestAsksDestination(t *testing.T) {
+	head := &Profile{URL: groupURL, Destination: groupURL, Method: MethodHEAD, Timeout: time.Second}
+	assert.False(t, head.AsksDestination(), "a HEAD to the url itself repeats the delay test")
+	assert.Equal(t, 5*time.Second, head.CheckTimeout(5*time.Second))
+
+	get := &Profile{URL: groupURL, Destination: groupURL, Method: MethodGET, Timeout: time.Second}
+	assert.True(t, get.AsksDestination())
+	assert.Equal(t, 6*time.Second, get.CheckTimeout(5*time.Second))
+
+	other := &Profile{URL: groupURL, Destination: "https://example.com/", Method: MethodHEAD}
+	assert.True(t, other.AsksDestination())
+}
+
+func TestHistoryLimitHoldsTheWindow(t *testing.T) {
+	assert.Equal(t, 10, (&Profile{Sampling: 1}).HistoryLimit(10))
+	assert.Equal(t, 10, (&Profile{Sampling: 4}).HistoryLimit(10))
+	assert.Equal(t, 13, (&Profile{Sampling: 6}).HistoryLimit(10))
+}
+
+func TestDailyTraffic(t *testing.T) {
+	p := &Profile{Method: MethodGET, Interval: 15 * time.Second}
+	assert.Equal(t, int64(0), p.DailyTraffic(20), "nothing read yet")
+	p.NoteBody(51200)
+	p.NoteBody(100) // the largest body counts
+	assert.Equal(t, int64(51200*20*5760), p.DailyTraffic(20))
+	assert.Equal(t, int64(0), (&Profile{Method: MethodHEAD, Interval: time.Second}).DailyTraffic(20))
+
+	assert.True(t, p.WarnOnce())
+	assert.False(t, p.WarnOnce())
+}
+
+func TestProfileJSON(t *testing.T) {
+	p, err := Parse(map[string]any{"interval": "15s", "timeout": "3s", "http-method": "GET", "sampling": 2}, defaults(), nil)
+	require.NoError(t, err)
+	body, err := json.Marshal(p)
+	require.NoError(t, err)
+	assert.JSONEq(t, `{"destination":"`+groupURL+`","interval":15,"sampling":2,"timeout":3000,"httpMethod":"GET"}`, string(body))
+
+	p.Connectivity = "http://example.com/"
+	body, err = json.Marshal(p)
+	require.NoError(t, err)
+	assert.Contains(t, string(body), `"connectivity":"http://example.com/"`)
+}
+
+// One profile per url: the first stays, a different second one is a
+// conflict, an identical one is not.
+func TestRegistryKeepsTheFirstProfile(t *testing.T) {
+	r := NewRegistry()
+	first, err := Parse(map[string]any{"http-method": "GET"}, Defaults{Group: "a", URL: groupURL}, nil)
+	require.NoError(t, err)
+	same, err := Parse(map[string]any{"http-method": "GET"}, Defaults{Group: "b", URL: groupURL}, nil)
+	require.NoError(t, err)
+	other, err := Parse(map[string]any{"http-method": "HEAD"}, Defaults{Group: "c", URL: groupURL}, nil)
+	require.NoError(t, err)
+
+	kept, conflict := r.Add(first)
+	assert.Same(t, first, kept)
+	assert.False(t, conflict)
+	kept, conflict = r.Add(same)
+	assert.Same(t, first, kept)
+	assert.False(t, conflict)
+	kept, conflict = r.Add(other)
+	assert.Same(t, first, kept)
+	assert.True(t, conflict)
+	assert.Equal(t, 1, r.Len())
+	assert.Same(t, first, r.Lookup(groupURL))
+	assert.Nil(t, r.Lookup("https://example.com/"))
+}
+
+func TestActiveRegistry(t *testing.T) {
+	defer SetActive(nil)
+	assert.Nil(t, Lookup(groupURL), "no config applied")
+
+	r := NewRegistry()
+	p := &Profile{URL: groupURL}
+	r.Add(p)
+	SetActive(r)
+	assert.Same(t, p, Lookup(groupURL))
+
+	SetActive(NewRegistry()) // a reload replaces it whole
+	assert.Nil(t, Lookup(groupURL))
+}
+
+// A node is scheduled by one owner at a url; the claim moves when the
+// owner lets go of it.
+func TestClaims(t *testing.T) {
+	a, b := new(int), new(int)
+	node, other := new(int), new(int)
+	defer Release(a)
+	defer Release(b)
+
+	assert.True(t, Claim(a, node, groupURL))
+	assert.True(t, Claim(a, node, groupURL), "the owner keeps it")
+	assert.False(t, Claim(b, node, groupURL))
+	assert.True(t, Claim(b, node, "https://example.com/"), "another url is another claim")
+	assert.True(t, Claim(a, other, groupURL))
+
+	Retain(a, groupURL, map[any]struct{}{other: {}})
+	assert.True(t, Claim(b, node, groupURL), "a dropped the node")
+	assert.False(t, Claim(b, other, groupURL))
+
+	Release(a)
+	assert.True(t, Claim(b, other, groupURL))
+}
+
+// The plan checks every node Sampling times, the k-th time within the
+// k-th interval, in time order; the same seed lays out the same plan.
+func TestPlan(t *testing.T) {
+	p := &Profile{Interval: 10 * time.Second, Sampling: 3}
+	slots := Plan(5, p, rand.New(rand.NewSource(1)))
+	require.Len(t, slots, 15)
+	seen := map[int][]time.Duration{}
+	for i, s := range slots {
+		if i > 0 {
+			assert.LessOrEqual(t, slots[i-1].Offset, s.Offset)
+		}
+		seen[s.Node] = append(seen[s.Node], s.Offset)
+	}
+	require.Len(t, seen, 5)
+	for node, offsets := range seen {
+		require.Len(t, offsets, 3, "node %d", node)
+		for k, offset := range offsets {
+			assert.GreaterOrEqual(t, offset, time.Duration(k)*p.Interval, "node %d sample %d", node, k)
+			assert.Less(t, offset, time.Duration(k+1)*p.Interval, "node %d sample %d", node, k)
+		}
+	}
+	assert.Equal(t, slots, Plan(5, p, rand.New(rand.NewSource(1))))
+	assert.NotEqual(t, slots, Plan(5, p, rand.New(rand.NewSource(2))))
+	assert.Empty(t, Plan(0, p, rand.New(rand.NewSource(1))))
+}
+
+func TestWindowStats(t *testing.T) {
+	now := time.Now()
+	at := func(ago time.Duration, delay uint16) C.DelayHistory {
+		return C.DelayHistory{Time: now.Add(-ago), Delay: delay}
+	}
+	window := time.Minute
+
+	alive, delay := WindowStats(nil, now, window)
+	assert.False(t, alive)
+	assert.Zero(t, delay)
+
+	// one success in the window keeps the node, its delay the mean of the successes
+	alive, delay = WindowStats([]C.DelayHistory{at(50*time.Second, 100), at(30*time.Second, 0), at(10*time.Second, 200)}, now, window)
+	assert.True(t, alive)
+	assert.Equal(t, uint16(150), delay)
+
+	alive, _ = WindowStats([]C.DelayHistory{at(50*time.Second, 0), at(10*time.Second, 0)}, now, window)
+	assert.False(t, alive)
+
+	// results older than the window do not count
+	alive, delay = WindowStats([]C.DelayHistory{at(2*time.Minute, 90), at(5*time.Second, 0)}, now, window)
+	assert.False(t, alive)
+	assert.Zero(t, delay)
+
+	// with nothing in the window, the last result decides
+	alive, delay = WindowStats([]C.DelayHistory{at(5*time.Minute, 0), at(3*time.Minute, 80)}, now, window)
+	assert.True(t, alive)
+	assert.Equal(t, uint16(80), delay)
+}
+
+// The device's network is asked once per connectivityTTL, however many
+// checks fail at once.
+func TestOnlineIsShared(t *testing.T) {
+	var probes atomic.Int32
+	probe := func() error {
+		probes.Add(1)
+		return errors.New("offline")
+	}
+	// the cache is the process's: a url of this run alone
+	url := fmt.Sprintf("http://connectivity.test/shared-%d", time.Now().UnixNano())
+	for i := 0; i < 5; i++ {
+		assert.False(t, Online(url, probe))
+	}
+	assert.Equal(t, int32(1), probes.Load())
+
+	assert.True(t, Online(url+"-other", func() error { return nil }))
+
+	time.Sleep(connectivityTTL + 100*time.Millisecond)
+	assert.False(t, Online(url, probe))
+	assert.Equal(t, int32(2), probes.Load())
+}
