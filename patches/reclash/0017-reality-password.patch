diff --git a/adapter/outbound/reality_password_test.go b/adapter/outbound/reality_password_test.go
new file mode 100644
index 0000000..51b225b
--- /dev/null
+++ b/adapter/outbound/reality_password_test.go
@@ -0,0 +1,17 @@
+package outbound
+
+import (
+	"encoding/base64"
+	"testing"
+)
+
+func TestRealityPasswordAlias(t *testing.T) {
+	key := base64.RawURLEncoding.EncodeToString(make([]byte, 32))
+	config, err := (RealityOptions{Password: key}).Parse()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config == nil || config.PublicKey == nil {
+		t.Fatal("password did not supply the REALITY public key")
+	}
+}
