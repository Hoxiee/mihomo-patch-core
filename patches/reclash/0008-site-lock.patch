mihomo-patch-core: reclash/0008-site-lock
Source: Hoxiee/mihomo 5635c762 (GPL-3.0), split from the ReClash core fork.

diff --git a/tunnel/patch.go b/tunnel/patch.go
index 99b9d9d..4d6c9b0 100644
--- a/tunnel/patch.go
+++ b/tunnel/patch.go
@@ -1,6 +1,7 @@
 package tunnel
 
 import (
+	"fmt"
 	"sync"
 
 	C "github.com/metacubex/mihomo/constant"
@@ -124,3 +125,17 @@ func ResolveRoute(metadata *C.Metadata) (C.Proxy, error) {
 
 var MetadataPolicyHook func(metadata *C.Metadata) error
 var ModeChangeHook func(mode TunnelMode)
+
+// SiteLockHook lets the host claim a connection before the mode, any rule or
+// a listener's own proxy is consulted: a non-nil proxy is used as is, and rule
+// names the claim. Only the inner listener's connections skip it. It runs
+// outside the config lock, may use helper's lazy lookups, and must not block
+// beyond them.
+var SiteLockHook func(metadata *C.Metadata, helper C.RuleMatchHelper) (C.Proxy, C.Rule)
+
+func specialProxy(metadata *C.Metadata) (C.Proxy, C.Rule, error) {
+	if proxy, ok := proxies[metadata.SpecialProxy]; ok {
+		return proxy, nil, nil
+	}
+	return nil, nil, fmt.Errorf("proxy %s not found", metadata.SpecialProxy)
+}
